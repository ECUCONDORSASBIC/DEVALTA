# Development Environment for AltaMedica
# This file is for development only

# Application
NODE_ENV=development
APP_VERSION=1.0.0

# Database Configuration (Development) - PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/altamedica_dev

# JWT Configuration  
JWT_SECRET=dev-super-secret-key-change-in-production-2024
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# API Configuration
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000

# WebRTC Configuration
NEXT_PUBLIC_SIGNALING_SERVER=ws://localhost:8888
TURN_SERVER_URL=turn:localhost:3478
TURN_SERVER_USERNAME=altamedica
TURN_SERVER_PASSWORD=dev-turn-secret

# Firebase Configuration (Development)
FIREBASE_PROJECT_ID=altamedica-dev
NEXT_PUBLIC_FIREBASE_API_KEY=dev-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=altamedica-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=altamedica-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=altamedica-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Medical Compliance (Development - Less Strict)
HIPAA_COMPLIANCE_MODE=false
AUDIT_LOG_RETENTION_DAYS=90
PHI_ENCRYPTION_ENABLED=true
MEDICAL_DATA_ENCRYPTION_KEY=dev-medical-encryption-key-32-ch

# Security (Development)
ENCRYPTION_KEY=dev-encryption-key-must-be-32-ch
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Rate Limiting (Relaxed for Development)
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_MEDICAL_REQUESTS_PER_MINUTE=500

# Logging
LOG_LEVEL=debug
PINO_LOG_LEVEL=debug

# Prometheus Metrics
PROMETHEUS_ENABLED=true
METRICS_ENDPOINT=/api/v1/metrics

# External Services (Development/Mock)
MERCADOPAGO_ACCESS_TOKEN=TEST-your-mercadopago-token
SENDGRID_API_KEY=SG.dev-sendgrid-key
TWILIO_ACCOUNT_SID=dev-twilio-sid
TWILIO_AUTH_TOKEN=dev-twilio-token

# AI Services (Development)
OPENAI_API_KEY=sk-dev-openai-key
ANTHROPIC_API_KEY=sk-dev-anthropic-key

# Development Flags
NEXT_TELEMETRY_DISABLED=1
CYPRESS_RECORD_KEY=dev-cypress-key
DEBUG=altamedica:*
DEVELOPMENT_MODE=true
MOCK_EXTERNAL_SERVICES=true

# Telemedicine Configuration
TELEMEDICINE_MAX_SESSION_DURATION=3600000  # 1 hour in milliseconds
TELEMEDICINE_CLEANUP_INTERVAL=86400000     # 24 hours in milliseconds
TELEMEDICINE_MAX_PARTICIPANTS=10
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Chat Configuration
CHAT_MESSAGE_MAX_LENGTH=1000
CHAT_HISTORY_RETENTION_DAYS=365
CHAT_RATE_LIMIT_PER_MINUTE=60
