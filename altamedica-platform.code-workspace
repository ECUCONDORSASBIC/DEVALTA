  "settings": {
    "typescript.preferences.includePackageJsonAutoImports": "on",
    "typescript.suggest.autoImports": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/dist": true,
      "**/.turbo": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/dist": true,
      "**/.turbo": true
    },
    "turbo.logs": "full",
    "pnpm.enableScripts": true,
    "workbench.colorCustomizations": {
      "activityBar.background": "#1e1e1e",
      "activityBar.foreground": "#ffffff",
      "activityBar.activeBorder": "#007acc",
      "activityBarBadge.background": "#007acc",
      "activityBarBadge.foreground": "#ffffff"
    },
    "workbench.iconTheme": "material-icon-theme",
    "material-icon-theme.folders.associations": {
      "doctors": "doctor",
      "patients": "user",
      "admin": "admin",
      "companies": "business",
      "medical": "medical",
      "api-server": "api",
      "development": "dev",
      "packages": "package",
      "configs": "config",
      "docs": "docs",
      "scripts": "script",
      "tools": "tools",
      "infrastructure": "infrastructure",
      "platform": "platform"
    }
  },
  "extensions": {
    "recommendations": [
      "bradlc.vscode-tailwindcss",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "ms-vscode.vscode-typescript-next",
      "ms-vscode.vscode-json",
      "formulahendry.auto-rename-tag",
      "christian-kohler.path-intellisense",
      "ms-vscode.vscode-todo-highlight",
      "gruntfuggly.todo-tree",
      "ms-vscode.vscode-git-graph",
      "eamodio.gitlens",
      "ms-vscode.vscode-docker",
      "firebase.firebase-explorer",
      "pkief.material-icon-theme",
      "ms-vscode.vscode-todo-highlight",
      "streetsidesoftware.code-spell-checker",
      "ms-vscode.vscode-json",
      "redhat.vscode-yaml"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🏥 Desarrollar DOCTORES",
        "type": "shell",
        "command": "pnpm",
        "args": ["dev:doctors"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared",
          "showReuseMessage": true,
          "clear": false
        },
        "problemMatcher": [],
        "detail": "Desarrollar aplicaciones de doctores (doctors, admin, companies, medical)"
      },
      {
        "label": "👥 Desarrollar PACIENTES",
        "type": "shell",
        "command": "pnpm",
        "args": ["dev:patients"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared",
          "showReuseMessage": true,
          "clear": false
        },
        "problemMatcher": [],
        "detail": "Desarrollar aplicaciones de pacientes (patients, web-app)"
      },
      {
        "label": "🏢 Desarrollar ROOT",
        "type": "shell",
        "command": "pnpm",
        "args": ["dev:root"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared",
          "showReuseMessage": true,
          "clear": false
        },
        "problemMatcher": [],
        "detail": "Desarrollar servicios centrales (api-server, development, anthropic-simulator)"
      },
      {
        "label": "📦 Desarrollar PACKAGES",
        "type": "shell",
        "command": "pnpm",
        "args": ["dev:packages"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared",
          "showReuseMessage": true,
          "clear": false
        },
        "problemMatcher": [],
        "detail": "Desarrollar packages compartidos"
      },
      {
        "label": "🚀 Desarrollar TODO",
        "type": "shell",
        "command": "pnpm",
        "args": ["dev:all"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared",
          "showReuseMessage": true,
          "clear": false
        },
        "problemMatcher": [],
        "detail": "Desarrollar todas las aplicaciones"
      },
      {
        "label": "🔍 Validar Workspace",
        "type": "shell",
        "command": "node",
        "args": ["scripts/validate-workspace.mjs"],
        "group": "test",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "problemMatcher": [],
        "detail": "Validar la organización del workspace"
      },
      {
        "label": "🧹 Limpiar Workspace",
        "type": "shell",
        "command": "pnpm",
        "args": ["clean:all"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "problemMatcher": [],
        "detail": "Limpiar todo el workspace"
      },
      {
        "label": "📦 Instalar Dependencias",
        "type": "shell",
        "command": "pnpm",
        "args": ["install"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "problemMatcher": [],
        "detail": "Instalar todas las dependencias"
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🏥 Debug DOCTORES",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/apps/doctors/src/index.ts",
        "cwd": "${workspaceFolder}/apps/doctors",
        "env": {
          "NODE_ENV": "development"
        }
      },
      {
        "name": "👥 Debug PACIENTES",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/apps/patients/src/index.ts",
        "cwd": "${workspaceFolder}/apps/patients",
        "env": {
          "NODE_ENV": "development"
        }
      },
      {
        "name": "🏢 Debug API-SERVER",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/apps/api-server/src/index.ts",
        "cwd": "${workspaceFolder}/apps/api-server",
        "env": {
          "NODE_ENV": "development"
        }
      }
    ]
