{
  "name": "sistema_completo_altamedica",
  "description": "Sistema completo de gestión médica AltaMedica con arquitectura full-stack moderna, seguridad avanzada e integración con servicios de salud",
  "type": "fullstack",
  "frontend": {
    "framework": "react",
    "styling": "tailwind",
    "ssr": true,
    "features": ["dashboard", "patient-management", "appointment-booking", "medical-records", "billing", "analytics"]
  },
  "backend": {
    "runtime": "node",
    "database": "postgresql",
    "features": ["auth", "api", "realtime", "file-storage", "notifications", "integrations"]
  },
  "features": [
    "patient-management",
    "doctor-management", 
    "appointment-scheduling",
    "medical-records",
    "prescription-management",
    "billing-system",
    "analytics-dashboard",
    "notification-system",
    "audit-logging",
    "integration-apis",
    "mobile-responsive",
    "accessibility-compliance"
  ],
  "pages": [
    "login",
    "dashboard",
    "patients",
    "appointments", 
    "medical-records",
    "prescriptions",
    "billing",
    "analytics",
    "settings",
    "profile"
  ],
  "integrations": [
    "firebase-auth",
    "firebase-firestore",
    "stripe-payments",
    "sendgrid-email",
    "twilio-sms",
    "health-apis"
  ],
  "security": {
    "authentication": "firebase-auth",
    "authorization": "rbac",
    "encryption": "aes-256",
    "compliance": ["hipaa", "gdpr"]
  },
  "scalability": {
    "level": "high",
    "requirements": ["horizontal-scaling", "load-balancing", "caching", "cdn"]
  },
  "performance": {
    "targets": {
      "load-time": "< 2s",
      "api-response": "< 500ms",
      "availability": "99.9%"
    }
  },
  "deployment": {
    "platform": "vercel",
    "database": "railway",
    "cdn": "cloudflare",
    "monitoring": "sentry"
  },
  "team": {
    "size": "medium",
    "budget": "default",
    "timeline": "3-months"
  }
}
