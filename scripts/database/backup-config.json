{
  "project": "AltaMedica Medical Platform",
  "version": "1.0",
  "lastUpdated": "2025-08-08T22:42:52.618Z",
  "database": {
    "type": "PostgreSQL",
    "host": "${POSTGRES_HOST:-localhost}",
    "port": "${POSTGRES_PORT:-5432}",
    "database": "${POSTGRES_DB:-altamedica}",
    "username": "${POSTGRES_USER:-altamedica}"
  },
  "backup": {
    "baseDirectory": "./backups/postgresql",
    "encryptionEnabled": true,
    "compressionLevel": 9,
    "retention": {
      "daily": 30,
      "weekly": 52,
      "monthly": 84,
      "yearly": 10
    },
    "notifications": {
      "email": {
        "enabled": false,
        "recipients": [
          "admin@altamedica.com",
          "it@altamedica.com"
        ]
      },
      "webhook": {
        "enabled": false,
        "url": "${BACKUP_WEBHOOK_URL}"
      },
      "slack": {
        "enabled": false,
        "webhook": "${SLACK_WEBHOOK_URL}"
      }
    }
  },
  "monitoring": {
    "healthCheckEnabled": true,
    "healthCheckInterval": "1h",
    "alertThresholds": {
      "backupSizeIncrease": 50,
      "backupDurationMinutes": 60,
      "failedBackupsBeforeAlert": 2
    }
  },
  "security": {
    "hipaaCompliant": true,
    "encryptionAlgorithm": "AES-256-GCM",
    "auditLogEnabled": true,
    "accessLogsRetention": 2555
  }
}