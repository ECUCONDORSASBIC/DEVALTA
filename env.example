# env.example
# Variables de entorno para el ecosistema Altamedica
# Copiar este archivo a .env y configurar los valores reales

# Configuración de la aplicación
NODE_ENV=production
PORT=3001

# Firebase Configuration
FIREBASE_PROJECT_ID=altamedica-prod
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Base de datos
POSTGRES_HOST=postgres
POSTGRES_USER=altamedica_user
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=altamedica

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password

# Encriptación
ENCRYPTION_SECRET=your-very-secure-encryption-secret-key

# URLs de las aplicaciones
NEXT_PUBLIC_API_URL=https://api.altamedica.com
NEXT_PUBLIC_ADMIN_URL=https://admin.altamedica.com
NEXT_PUBLIC_DOCTORS_URL=https://doctors.altamedica.com
NEXT_PUBLIC_PATIENTS_URL=https://patients.altamedica.com

# Monitoreo
GRAFANA_PASSWORD=your-secure-grafana-password

# Backup y almacenamiento
BACKUP_S3_BUCKET=altamedica-backups
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-west-2

# Integración con sistemas externos
LAB_SYSTEM_A_URL=https://lab-system-a.com/api
LAB_SYSTEM_A_KEY=your-lab-system-a-key
LAB_SYSTEM_B_URL=https://lab-system-b.com/api
LAB_SYSTEM_B_KEY=your-lab-system-b-key

# Hospital Information System
HIS_INTEGRATION_URL=https://his.altamedica.com/api
HIS_API_KEY=your-his-api-key

# Notificaciones
SLACK_WEBHOOK=https://hooks.slack.com/services/your/slack/webhook
EMAIL_RECIPIENT=admin@altamedica.com

# Seguridad
JWT_SECRET=your-jwt-secret-key
SESSION_SECRET=your-session-secret-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# SSL/TLS
SSL_CERT_PATH=/etc/nginx/ssl/altamedica.crt
SSL_KEY_PATH=/etc/nginx/ssl/altamedica.key

# Dominios
DOMAIN_MAIN=altamedica.com
DOMAIN_API=api.altamedica.com
DOMAIN_ADMIN=admin.altamedica.com
DOMAIN_DOCTORS=doctors.altamedica.com
DOMAIN_PATIENTS=patients.altamedica.com
DOMAIN_MONITORING=monitoring.altamedica.com 