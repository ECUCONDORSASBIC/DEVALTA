# ========================================
# VARIABLES DE ENTORNO CRÍTICAS - ALTAMEDICA
# ========================================
# COPIA ESTE ARCHIVO A .env.local Y CONFIGURA TUS VALORES

# ========================================
# FIREBASE CONFIGURATION
# ========================================
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com

# ========================================
# JWT & ENCRYPTION
# ========================================
JWT_SECRET=tu-jwt-secret-super-seguro-minimo-32-caracteres
ENCRYPTION_SECRET=tu-encryption-secret-32-caracteres

# ========================================
# DATABASE
# ========================================
DATABASE_URL="postgresql://usuario:password@localhost:5432/altamedica_db"

# ========================================
# REDIS
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# EXTERNAL APIs
# ========================================
OPENAI_API_KEY=sk-tu-api-key-aqui
ANTHROPIC_API_KEY=sk-ant-tu-api-key-aqui

# ========================================
# MONITORING
# ========================================
SENTRY_DSN=https://tu-dsn-sentry@sentry.io/project-id
NODE_ENV=development

# ========================================
# SECURITY
# ========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# NOTIFICATIONS
# ========================================
TWILIO_ACCOUNT_SID=tu-account-sid
TWILIO_AUTH_TOKEN=tu-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ========================================
# FILE STORAGE
# ========================================
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ========================================
# WEBRTC
# ========================================
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302 