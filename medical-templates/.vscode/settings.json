{
  "files.associations": {
    "**/src/**/*.js": "javascript",
    "**/src/**/*.jsx": "javascriptreact",
    "**/src/**/*.ts": "typescript",
    "**/src/**/*.tsx": "typescriptreact",
    "**/test/**/*.js": "javascript",
    "**/test/**/*.jsx": "javascriptreact"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "java.configuration.updateBuildConfiguration": "automatic",
  "jest.pathToJest": "npm test",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  }
}
