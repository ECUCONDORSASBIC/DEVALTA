{
  "name": "altamedica-platform",
  "version": "1.0.0",
  "description": "AltaMedica - Plataforma de Telemedicina Integral",
  "private": true,
  
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:min": "concurrently \"pnpm --filter web-app dev\" \"pnpm --filter patients dev\" \"pnpm --filter api-server dev\" \"pnpm --filter doctors dev\"",
    "start:all-servers": "node start-all-servers.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "type-check": "turbo run type-check",
    "clean:node-modules": "python scripts/clean-monorepo.py",
    "clean:complete": "python scripts/clean-monorepo.py --install",
    "fresh-install": "python scripts/clean-monorepo.py --fresh-install",
    "clean:reset": "python scripts/clean-monorepo.py --reset",
    "clean:deps": "python scripts/clean-monorepo.py --deps",
    "clean:cache": "python scripts/clean-monorepo.py --cache",
    "clean:builds": "python scripts/clean-monorepo.py --builds",
    "clean:logs": "python scripts/clean-monorepo.py --logs",
    "clean:python": "python scripts/clean-monorepo.py --python",
    "clean:analyze": "python scripts/clean-monorepo.py --analyze",
    "clean:dry-run": "python scripts/clean-monorepo.py --dry-run",
    "clean:check-env": "python scripts/clean-monorepo.py --check-env",
    "clean:fix-permissions": "python scripts/clean-monorepo.py --fix-permissions",
    "clean:help": "python scripts/clean-monorepo.py --help",
    "audit:single-login": "node tools/scripts/enforce-single-login.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "concurrently": "^8.2.2",
    "turbo": "^1.13.4"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "undici": "^6.21.2",
      "esbuild": "^0.25.0",
      "cookie": "^0.7.0",
      "on-headers": "^1.1.0",
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "@types/react": "^18.3.23",
      "@types/react-dom": "^18.3.5"
    }
  }
}