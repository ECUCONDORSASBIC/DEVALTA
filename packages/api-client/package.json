{
  "name": "@altamedica/api-client",
  "version": "1.0.0",
  "description": "Centralized API client for AltaMedica platform with type safety and error handling",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
  "lint": "eslint . --ext .ts,.tsx --no-error-on-unmatched-pattern",
  "lint:fix": "eslint . --ext .ts,.tsx --fix --no-error-on-unmatched-pattern",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@altamedica/auth": "workspace:*",
    "@altamedica/hooks": "workspace:*",
    "@altamedica/types": "workspace:*",
    "@tanstack/react-query": "^5.17.19",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "typescript": "^5.3.3",
    
    "react-hot-toast": "^2.4.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}