{
  "extends": "../../configs/base/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "noEmit": false,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@altamedica/types": ["../types/src"],
      "@altamedica/types/*": ["../types/src/*"]
    }
  },
  "references": [
    { "path": "../types" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
