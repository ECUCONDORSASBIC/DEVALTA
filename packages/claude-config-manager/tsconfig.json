{
  "extends": "../configs/base/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@altamedica/types": [
        "../types/src"
      ],
      "@altamedica/types/*": [
        "../types/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}