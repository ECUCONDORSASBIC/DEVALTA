{
  "name": "@altamedica/api-helpers",
  "version": "1.0.0",
  "description": "API response helpers and utilities for AltaMedica",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --format cjs --dts",
    "dev": "tsup src/index.ts --format esm --format cjs --dts --watch",
    "clean": "powershell -Command \"Remove-Item -Path dist -Recurse -Force -ErrorAction SilentlyContinue\""
  },
  "dependencies": {
    "zod": "^3.22.4",
    "next": "^14.2.0"
  },
  "devDependencies": {
    "@altamedica/typescript-config": "workspace:*",
    "tsup": "^8.0.0",
  "typescript": "^5.3.0",
  "@types/cookie": "^0.5.4",
  "@types/minimatch": "^6.0.0"
  },
  "peerDependencies": {
    "next": "^14.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ]
}