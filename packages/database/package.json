{
  "name": "@altamedica/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capa de acceso a datos Postgres mediante Prisma para Altamedica",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "dev": "echo 'Database package - development mode (no server needed)'",
    "dev:watch": "ts-node-dev --respawn src/index.ts",
    "dev:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@prisma/client": "^5.5.0"
  },
  "devDependencies": {
    "prisma": "^5.5.0",
    "typescript": "^5.8.3",
    "ts-node-dev": "^2.0.0"
  }
}
