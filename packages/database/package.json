{
  "name": "@altamedica/database",
  "version": "2.0.0",
  "description": "AltaMedica unified database layer with Firebase/Firestore, HIPAA compliance, and medical data optimization",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./repositories": "./src/repositories/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./services": "./src/services/index.ts",
    "./security": "./src/security/index.ts",
    "./cache": "./src/cache/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
  "lint": "eslint . --ext .ts,.tsx --no-error-on-unmatched-pattern",
  "lint:fix": "eslint . --ext .ts,.tsx --fix --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@altamedica/firebase-admin": "workspace:*",
    "zod": "^3.22.4",
    "redis": "^4.6.13",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "crypto": "^1.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "prisma": "^5.7.0",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0"
  },
  "peerDependencies": {
    "@altamedica/types": "workspace:*",
    "@altamedica/shared": "workspace:*"
  }
}