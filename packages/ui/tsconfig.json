{
  "extends": "../configs/base/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "incremental": true,
    "noEmit": false,
    "noEmitOnError": false,
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@altamedica/types": [
        "../types/src"
      ],
      "@altamedica/types/*": [
        "../types/src/*"
      ],
      "@altamedica/core": [
        "../core/src"
      ],
      "@altamedica/core/*": [
        "../core/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../../apps/**/*",
    "../../packages/!(ui)/**/*",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}