{
  "name": "@altamedica/telemedicine-core",
  "version": "1.0.0",
  "description": "Core telemedicine functionality shared between doctor and patient apps",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client/index.js",
    "./hooks": "./dist/hooks/index.js",
    "./types": "./dist/types/index.js",
    "./utils": "./dist/utils/index.js"
  },
  "dependencies": {
    "@altamedica/types": "workspace:*",
    "@altamedica/shared": "workspace:*",
    "socket.io-client": "^4.7.4",
    "webrtc-adapter": "^8.2.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
} 