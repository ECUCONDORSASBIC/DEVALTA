{
  "name": "@alta/ml-core",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup src/index.ts --watch",
    "build": "tsup src/index.ts",
    "test": "jest",
    "lint": "eslint src/ --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^6.2.0",
    "@google-cloud/storage": "^6.12.0",
    "@tensorflow/tfjs": "^4.17.0",
    "@tensorflow/tfjs-node": "^4.17.0",
    "firebase-admin": "^11.11.0",
    "zod": "^3.22.4",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0",
    "p-queue": "^7.4.1",
    "bull": "^4.11.5",
    "ioredis": "^5.3.2"
  },
  "peerDependencies": {
    "@alta/core": "workspace:*",
    "@alta/types": "workspace:*",
    "@alta/firebase": "workspace:*",
    "@alta/logger": "workspace:*"
  },
  "devDependencies": {
    "@alta/eslint-config": "workspace:*",
    "@alta/typescript-config": "workspace:*",
    "@types/node": "^20.11.5",
    "@types/uuid": "^9.0.7",
    "@types/bull": "^4.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0"
  }
}
