{
  "name": "@altamedica/ai-medical-core",
  "version": "1.0.0",
  "description": "Core de inteligencia artificial médica para Altamedica",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./chatbot": {
      "types": "./dist/chatbot/index.d.ts",
      "import": "./dist/chatbot/index.mjs",
      "require": "./dist/chatbot/index.js"
    },
    "./diagnostic": {
      "types": "./dist/diagnostic/index.d.ts",
      "import": "./dist/diagnostic/index.mjs",
      "require": "./dist/diagnostic/index.js"
    },
    "./nlp": {
      "types": "./dist/nlp/index.d.ts",
      "import": "./dist/nlp/index.mjs",
      "require": "./dist/nlp/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^0.1.0",
    "@langchain/openai": "^0.0.10",
    "@pinecone-database/pinecone": "^2.0.0",
    "@tensorflow/tfjs-node": "^4.15.0",
    "openai": "^4.24.0",
    "natural": "^6.10.0",
    "compromise": "^14.10.0",
    "fhir": "^4.11.1",
    "ioredis": "^5.3.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}