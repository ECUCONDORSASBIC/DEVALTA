# 🚀 Configuración PNPM sin restricciones para AltaMedica
# Optimizado para desarrollo local Windows sin bloqueos

# Habilitar workspaces
enable-pre-post-scripts=true
auto-install-peers=true
dedupe-peer-dependents=false

# Performance optimization
registry=https://registry.npmjs.org/
prefer-frozen-lockfile=false
strict-peer-dependencies=false

# Caching optimizado
store-dir=C:\Users\Eduardo\.pnpm-store
cache-dir=C:\Users\Eduardo\.pnpm-cache

# Hoisting y linking
hoist=true
hoist-pattern[]=*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*typescript*
public-hoist-pattern[]=@types/*

# Sin restricciones de scripts
enable-modules-dir=true
modules-cache-max-age=7200000

# Network optimization
network-concurrency=16
child-concurrency=5
network-timeout=60000
fetch-retries=5
fetch-retry-factor=10
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Symlinks y paths
symlink=true
package-import-method=auto

# Progress y logging
progress=true
reporter=default
loglevel=info

# Audit y security
audit-level=moderate

# Node linker optimizado
node-linker=isolated