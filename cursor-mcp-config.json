{
  "mcpServers": {
    "terminal": {
      "command": "node",
      "args": ["mcp-servers/enhanced-multi-agent-mcp.js"],
      "env": {
        "NODE_ENV": "development"
      }
    },
    "codebase-intelligence": {
      "command": "node",
      "args": ["mcp-protected/servers/codebase-intelligence-mcp.js"],
      "env": {
        "PROJECT_ROOT": ".",
        "NODE_ENV": "development"
      }
    },
    "ai-flow-orchestrator": {
      "command": "node",
      "args": ["mcp-protected/servers/ai-flow-orchestrator-mcp.js"],
      "env": {
        "PROJECT_ROOT": ".",
        "NODE_ENV": "development"
      }
    },
    "frontend-error-handler": {
      "command": "node",
      "args": ["mcp-protected/servers/frontend-error-handler.js"],
      "env": {
        "PROJECT_ROOT": ".",
        "NODE_ENV": "development"
      }
    },
    "system-configuration": {
      "command": "node",
      "args": ["mcp-servers/system-configuration.js"],
      "env": {
        "PROJECT_ROOT": ".",
        "NODE_ENV": "development"
      }
    }
  },
  "settings": {
    "enableLogging": true,
    "logLevel": "info",
    "timeout": 30000,
    "maxRetries": 3
  }
} 