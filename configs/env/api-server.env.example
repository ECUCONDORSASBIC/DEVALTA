# =====================================================
# VARIABLES DE ENTORNO - SERVIDOR API ALTAMEDICA
# =====================================================

# Configuración de la Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=altamedica_db
DB_USER=altamedica_app
DB_PASSWORD=altamedica_secure_password_2024

# Configuración JWT
JWT_SECRET=altamedica_jwt_secret_2024_super_secure_key_for_production

# Configuración de Firebase Admin
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=altamedica-medical
FIREBASE_PRIVATE_KEY_ID=your_private_key_id_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@altamedica-medical.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id_here
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40altamedica-medical.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://altamedica-medical-default-rtdb.firebaseio.com

# Configuración de Firebase Client (para frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=altamedica-medical.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=altamedica-medical
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=altamedica-medical.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Configuración de URLs
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
DOCTORS_URL=http://localhost:3003
PATIENTS_URL=http://localhost:3004
ADMIN_URL=http://localhost:3005

# Configuración de CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3003,http://localhost:3004,http://localhost:3005

# Configuración de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuración de Logging
LOG_LEVEL=info
NODE_ENV=development

# Configuración de Seguridad
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=altamedica_session_secret_2024

# Configuración de Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Configuración de Telemedicina
TELEMEDICINE_SERVER_URL=ws://localhost:8080
MEDIASOUP_CONFIG_PATH=./configs/mediasoup.json

# Configuración de Monitoreo
ENABLE_METRICS=true
METRICS_PORT=9090

# Configuración de Cache
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Configuración de Archivos
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Configuración de Notificaciones
PUSH_NOTIFICATIONS_ENABLED=true
FCM_SERVER_KEY=your_fcm_server_key_here

# Configuración de Analytics
ANALYTICS_ENABLED=true
GOOGLE_ANALYTICS_ID=your_ga_id_here

# Configuración de Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Configuración de Compliance
HIPAA_COMPLIANCE_ENABLED=true
AUDIT_LOGGING_ENABLED=true
DATA_ENCRYPTION_ENABLED=true

# Configuración de Testing
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/altamedica_test
TEST_FIREBASE_PROJECT_ID=altamedica-test 