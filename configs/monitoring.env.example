# ========================================
# CONFIGURACIÓN DE MONITOREO MÉDICO
# ========================================

# SENTRY CONFIGURATION
# ====================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=altamedica
SENTRY_PROJECT=medical-platform
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# DATADOG CONFIGURATION
# ====================
DATADOG_HOST=localhost
DATADOG_PORT=8125
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key
DATADOG_ENV=production

# ENCRYPTION KEYS (MÉDICAS)
# =========================
MEDICAL_ENCRYPTION_KEY=your-super-secure-encryption-key-256-bits
MEDICAL_SALT_KEY=your-salt-key-for-medical-data

# HIPAA COMPLIANCE
# ================
HIPAA_AUDIT_ENABLED=true
HIPAA_LOG_RETENTION_DAYS=2555
HIPAA_PHI_ACCESS_LOGGING=true

# ALERTAS Y NOTIFICACIONES
# ========================
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_FROM=alerts@altamedica.com
ALERT_EMAIL_TO=admin@altamedica.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
SLACK_CHANNEL=#medical-alerts

# HEALTH CHECK CONFIGURATION
# ==========================
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_ENABLED=true

# MONITORING INTERVALS
# ===================
METRICS_FLUSH_INTERVAL=15000
ALERT_CHECK_INTERVAL=60000
AUDIT_CLEANUP_INTERVAL=86400000

# ENVIRONMENT
# ===========
NODE_ENV=production
NEXT_PUBLIC_ENVIRONMENT=production 