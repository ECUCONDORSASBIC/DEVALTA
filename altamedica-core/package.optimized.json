{
  "name": "altamedica-core-optimized",
  "version": "2.0.0",
  "description": "Sistema integral de gestión médica con micro-frontends optimizados - Compliance HIPAA",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:check && next build",
    "build:check": "npm run type-check && npm run lint:check",
    "build:analyze": "ANALYZE=true npm run build",
    "build:microfrontends": "webpack --mode=production --config webpack.config.js",
    "build:performance": "npm run build && npm run analyze:performance",
    
    "start": "next start",
    "start:production": "NODE_ENV=production npm run start",
    
    "lint": "next lint --fix",
    "lint:check": "next lint",
    "lint:css": "stylelint \"src/**/*.css\" --fix",
    
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:microfrontends": "jest --testPathPattern=microfrontends",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    
    "dev:microfrontends": "concurrently \"npm run dev:shell\" \"npm run dev:patient\" \"npm run dev:appointments\" \"npm run dev:telemedicine\"",
    "dev:shell": "webpack serve --mode=development --config webpack.config.js --port 3000",
    "dev:patient": "webpack serve --mode=development --config microfrontends/patient-management/webpack.config.js --port 3001",
    "dev:appointments": "webpack serve --mode=development --config microfrontends/appointment-scheduling/webpack.config.js --port 3002",
    "dev:telemedicine": "webpack serve --mode=development --config microfrontends/telemedicine/webpack.config.js --port 3003",
    
    "analyze:bundle": "npx webpack-bundle-analyzer .next/static/chunks/",
    "analyze:performance": "node scripts/analyze-performance.js",
    "analyze:dependencies": "madge --circular --extensions js,ts,tsx src/",
    "analyze:duplicates": "npx jscpd src/",
    "analyze:security": "npm audit --audit-level=moderate",
    
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:cache": "node scripts/optimize-cache.js",
    "optimize:bundle": "node scripts/optimize-bundle.js",
    
    "medical:compliance-check": "node scripts/medical-compliance-check.js",
    "medical:hipaa-audit": "node scripts/hipaa-audit.js",
    "medical:performance-report": "node scripts/medical-performance-report.js",
    
    "deploy:staging": "npm run build && npm run deploy:staging:upload",
    "deploy:production": "npm run medical:compliance-check && npm run build && npm run deploy:production:upload",
    "deploy:staging:upload": "echo 'Deploy to staging'",
    "deploy:production:upload": "echo 'Deploy to production'",
    
    "clean": "rimraf .next dist coverage node_modules/.cache",
    "clean:cache": "rimraf .next/cache node_modules/.cache",
    "clean:deps": "rimraf node_modules package-lock.json && npm install",
    
    "precommit": "lint-staged",
    "prepare": "husky install",
    
    "docker:build": "docker build -t altamedica-core .",
    "docker:run": "docker run -p 3000:3000 altamedica-core",
    
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    
    "tailwindcss": "^3.3.6",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    
    "@module-federation/nextjs-mf": "^8.1.3",
    "@module-federation/webpack": "^2.3.0",
    
    "firebase": "^10.7.1",
    "firebase-admin": "^11.11.1",
    "@firebase/auth": "^1.5.1",
    "@firebase/firestore": "^4.4.0",
    
    "prisma": "^5.7.1",
    "@prisma/client": "^5.7.1",
    
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "crypto-js": "^4.2.0",
    
    "zod": "^3.22.4",
    "react-hook-form": "^7.48.2",
    "@hookform/resolvers": "^3.3.2",
    
    "date-fns": "^2.30.0",
    "react-calendar": "^4.6.0",
    "recharts": "^2.8.0",
    
    "lucide-react": "^0.294.0",
    "@headlessui/react": "^1.7.17",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-toast": "^1.1.5",
    "framer-motion": "^10.16.16",
    
    "react-pdf": "^7.6.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    
    "lru-cache": "^10.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.0",
    
    "react-error-boundary": "^4.0.11",
    "use-debounce": "^10.0.0",
    "use-immer": "^0.9.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/crypto-js": "^4.2.1",
    "@types/jest": "^29.5.8",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/user-event": "^14.5.1",
    
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.0.4",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@playwright/test": "^1.40.1",
    
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-bundle-analyzer": "^4.10.1",
    "html-webpack-plugin": "^5.5.4",
    "mini-css-extract-plugin": "^2.7.6",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "terser-webpack-plugin": "^5.3.9",
    "compression-webpack-plugin": "^10.0.0",
    
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@babel/plugin-transform-runtime": "^7.23.6",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "babel-plugin-import": "^1.13.8",
    
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "postcss-loader": "^7.3.3",
    "cssnano": "^6.0.2",
    
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "rimraf": "^5.0.5",
    "madge": "^6.1.0",
    "jscpd": "^3.5.10",
    
    "@storybook/addon-essentials": "^7.6.3",
    "@storybook/addon-interactions": "^7.6.3",
    "@storybook/addon-links": "^7.6.3",
    "@storybook/blocks": "^7.6.3",
    "@storybook/react": "^7.6.3",
    "@storybook/react-webpack5": "^7.6.3",
    "@storybook/testing-library": "^0.2.2",
    "storybook": "^7.6.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run type-check && npm run test",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "medical",
    "healthcare",
    "hipaa",
    "micro-frontends",
    "performance",
    "argentina",
    "telemedicine",
    "patient-management",
    "next.js",
    "react",
    "typescript"
  ],
  "author": "Eduardo - Altamedica Development Team",
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "https://github.com/altamedica/core-system.git"
  },
  "homepage": "https://altamedica.com"
}