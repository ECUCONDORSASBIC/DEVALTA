// Configuración TypeScript optimizada para Micro-frontends Médicos
// Altamedica - Type Safety + Performance

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES6"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    
    // Path mapping optimizado para micro-frontends
    "baseUrl": ".",
    "paths": {
      // Core paths (existentes)
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/types/*": ["./src/types/*"],
      "@/medical/*": ["./src/components/medical/*"],
      
      // Micro-frontends paths
      "@/microfrontends/*": ["./src/microfrontends/*"],
      "@/shared/*": ["./src/microfrontends/shared/*"],
      "@/patient-management/*": ["./src/microfrontends/patient-management/*"],
      "@/appointment-scheduling/*": ["./src/microfrontends/appointment-scheduling/*"],
      "@/telemedicine/*": ["./src/microfrontends/telemedicine/*"],
      
      // Performance optimized imports
      "@/optimized/*": ["./src/optimized/*"],
      "@/lazy/*": ["./src/lazy/*"],
      "@/cache/*": ["./src/cache/*"]
    },
    
    // Configuración estricta para calidad de código
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    
    // Optimizaciones de performance
    "preserveWatchOutput": true,
    "pretty": true,
    "removeComments": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    
    // Module Federation types
    "types": [
      "node",
      "@types/react",
      "@types/react-dom",
      "@module-federation/nextjs-mf"
    ]
  },
  
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/**/*",
    "src/microfrontends/**/*"
  ],
  
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "build",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts", 
    "**/*.spec.tsx"
  ],
  
  // Referencias para micro-frontends
  "references": [
    {
      "path": "./src/microfrontends/patient-management"
    },
    {
      "path": "./src/microfrontends/appointment-scheduling"
    },
    {
      "path": "./src/microfrontends/telemedicine"
    },
    {
      "path": "./src/microfrontends/shared"
    }
  ],
  
  // Configuración de watch mode optimizada
  "watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriority",
    "synchronousWatchDirectory": true,
    "excludeDirectories": [
      "**/node_modules",
      "**/.git",
      "**/.next"
    ]
  },
  
  // Configuración de compilación incremental
  "compileOnSave": false,
  "buildOnSave": false
}