# =============================================================================
# ALTAMEDICA TELEMEDICINE SERVER - ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# Este archivo contiene las variables de entorno necesarias para el servidor
# de telemedicina con Mediasoup. Copia este archivo a .env.telemedicine y
# ajusta los valores según tu entorno.
#
# HIPAA COMPLIANCE: Todas las configuraciones están diseñadas para cumplir
# con los estándares HIPAA para telemedicina.
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3001
HOSTNAME=localhost
APP_VERSION=1.0.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/altamedica_telemedicine
DATABASE_ENCRYPTION_KEY=your-32-character-encryption-key-here

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET=your-super-secure-jwt-secret-key-here-minimum-32-chars
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=your-32-character-encryption-key-here

# =============================================================================
# MEDIASOUP CONFIGURATION (WebRTC Server)
# =============================================================================
# Número de workers de Mediasoup (recomendado: 2-4 para desarrollo, 4-8 para producción)
MEDIASOUP_WORKERS=2

# Nivel de logging de Mediasoup (debug, warn, error)
MEDIASOUP_LOG_LEVEL=warn

# IP de escucha para Mediasoup (usar 0.0.0.0 para producción)
MEDIASOUP_LISTEN_IP=127.0.0.1

# IP anunciada para WebRTC (usar IP pública en producción)
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# Rango de puertos RTC (WebRTC)
MEDIASOUP_RTC_MIN_PORT=10000
MEDIASOUP_RTC_MAX_PORT=10100

# =============================================================================
# HIPAA COMPLIANCE & AUDITING
# =============================================================================
# Habilitar logging de auditoría HIPAA
HIPAA_AUDIT_ENABLED=true

# Retención de logs en días (HIPAA requiere mínimo 6 años)
AUDIT_RETENTION_DAYS=2555

# Habilitar logging de acceso a PHI
PHI_ACCESS_LOGGING=true

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Sentry para monitoreo de errores
SENTRY_DSN=https://your-sentry-dsn-here

# Elasticsearch para logs de auditoría
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password

# Redis para cache y sesiones
REDIS_URL=redis://localhost:6379

# =============================================================================
# TELEMEDICINE FEATURES
# =============================================================================
# Habilitar grabación de sesiones (requiere consentimiento del paciente)
TELEMEDICINE_RECORDING_ENABLED=false

# Ruta para almacenar grabaciones
TELEMEDICINE_RECORDING_PATH=/var/altamedica/recordings

# Habilitar chat en sesiones de telemedicina
TELEMEDICINE_CHAT_ENABLED=true

# Habilitar compartir signos vitales
TELEMEDICINE_VITALS_SHARING=true

# Tiempo máximo de sesión en minutos
TELEMEDICINE_MAX_SESSION_DURATION=120

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Email para notificaciones
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Webhook para notificaciones externas
WEBHOOK_URL=https://your-webhook-url.com/notifications

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# URL del frontend
FRONTEND_URL=http://localhost:3000

# API Keys para servicios externos
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================
# Habilitar modo debug
DEBUG=false

# Log level para la aplicación
LOG_LEVEL=info

# Habilitar CORS para desarrollo
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# PRODUCTION SETTINGS (cambiar en producción)
# =============================================================================
# En producción, usar:
# NODE_ENV=production
# MEDIASOUP_LISTEN_IP=0.0.0.0
# MEDIASOUP_ANNOUNCED_IP=your-public-ip
# MEDIASOUP_WORKERS=4
# TELEMEDICINE_RECORDING_ENABLED=true
# DEBUG=false
# LOG_LEVEL=warn

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Cambia todas las claves secretas en producción
# 2. Usa HTTPS en producción
# 3. Configura firewalls para los puertos RTC
# 4. Implementa rate limiting
# 5. Configura backup automático de logs
# 6. Monitorea acceso a PHI
# 7. Implementa autenticación de dos factores
# 8. Configura alertas de seguridad
# ============================================================================= 