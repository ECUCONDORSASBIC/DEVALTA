{
  "name": "@altamedica/api-server",
  "version": "1.0.0",
  "description": "ALTAMEDICA Main API Server - Central orchestration and core endpoints",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf .next dist coverage"
  },
  "dependencies": {
    "@altamedica/firebase": "workspace:*",
    "@altamedica/shared": "workspace:*",
    "@altamedica/types": "workspace:*",
    "axios": "^1.10.0",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^12.0.0",
    "ioredis": "^5.3.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.445.0",
    "next": "^15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^4.2.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.3.4",
    "@types/express-rate-limit": "^6.0.0",
    "@types/leaflet": "^1.9.18",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}