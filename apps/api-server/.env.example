# 🏥 ALTAMEDICA - CONFIGURACIÓN DE PRODUCCIÓN
# Copiar este archivo como .env.local y configurar valores reales

# ==========================================
# CONFIGURACIÓN GENERAL
# ==========================================
NODE_ENV=production
APP_VERSION=1.0.0
APP_NAME=AltaMedica
PORT=3000

# ==========================================
# BASE DE DATOS
# ==========================================
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=altamedica_prod
DB_USER=altamedica_user
DB_PASSWORD=CAMBIA_ESTA_CONTRASEÑA_SUPER_SEGURA
DB_SSL=true
DB_POOL_SIZE=20
DB_TIMEOUT=30000

# ==========================================
# REDIS (CACHING Y SESIONES)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIA_ESTA_CONTRASEÑA_REDIS
REDIS_DB=0
REDIS_TLS=true

# ==========================================
# AUTENTICACIÓN Y SEGURIDAD
# ==========================================
JWT_SECRET=CAMBIA_ESTE_JWT_SECRET_MUY_LARGO_Y_COMPLEJO_PARA_PRODUCCION
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=altamedica-api
JWT_AUDIENCE=altamedica-apps

# Encriptación de datos PHI (CRÍTICO - USAR GESTIÓN DE CLAVES REAL)
ENCRYPTION_MASTER_KEY=USAR_AWS_KMS_O_HASHICORP_VAULT_EN_PRODUCCION
ENCRYPTION_ALGORITHM=aes-256-gcm

# ==========================================
# APIS EXTERNAS Y SERVICIOS
# ==========================================

# Firebase Admin SDK (Configuración para serverless)
# Opción 1: Usar archivo JSON completo de la cuenta de servicio (RECOMENDADO)
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"altamedica-prod","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@altamedica-prod.iam.gserviceaccount.com","client_id":"xxx","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"xxx"}'

# Opción 2: Usar variables individuales (para compatibilidad)
FIREBASE_PROJECT_ID=altamedica-prod
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_FIREBASE\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@altamedica-prod.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=altamedica-prod.appspot.com

# Variables adicionales Firebase (opcionales)
FIREBASE_PRIVATE_KEY_ID=tu_private_key_id
FIREBASE_CLIENT_ID=tu_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=tu_cert_url

# Firebase Database URL (si usas Realtime Database)
# FIREBASE_DATABASE_URL=https://altamedica-prod.firebaseio.com

# FCM (Push Notifications)
FCM_SERVER_KEY=TU_FCM_SERVER_KEY_AQUI
VAPID_PUBLIC_KEY=TU_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=TU_VAPID_PRIVATE_KEY

# SendGrid (Emails)
SENDGRID_API_KEY=SG.TU_SENDGRID_API_KEY_AQUI
SENDGRID_FROM_EMAIL=noreply@altamedica.com
SENDGRID_FROM_NAME=AltaMedica

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# ALMACENAMIENTO
# ==========================================

# AWS S3 (Documentos médicos, imágenes)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=TU_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=TU_AWS_SECRET_KEY
AWS_S3_BUCKET=altamedica-medical-documents
AWS_S3_REGION=us-east-1

# Cloudinary (Procesamiento de imágenes)
CLOUDINARY_CLOUD_NAME=tu_cloudinary_cloud
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret

# ==========================================
# TELEMEDICINA
# ==========================================

# Servidores STUN/TURN para WebRTC
STUN_SERVER_1=stun:stun.l.google.com:19302
STUN_SERVER_2=stun:stun1.l.google.com:19302
TURN_SERVER_URL=turn:tu-servidor-turn.com:3478
TURN_USERNAME=tu_turn_username
TURN_PASSWORD=tu_turn_password

# Agora.io (Alternativa para video)
AGORA_APP_ID=tu_agora_app_id
AGORA_APP_CERTIFICATE=tu_agora_app_certificate

# ==========================================
# MONITOREO Y LOGGING
# ==========================================

# Sentry (Error Tracking)
SENTRY_DSN=https://tu_sentry_dsn@sentry.io/proyecto
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0

# Datadog (Métricas y APM)
DATADOG_API_KEY=tu_datadog_api_key
DATADOG_APP_KEY=tu_datadog_app_key
DATADOG_SITE=datadoghq.com

# LogDNA/LogRocket (Logs)
LOGDNA_INGESTION_KEY=tu_logdna_key

# ==========================================
# WEBHOOKS Y INTEGRACIONES
# ==========================================

# Slack (Alertas)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TU/WEBHOOK/URL
SLACK_CHANNEL=#altamedica-alertas

# Microsoft Teams (Alertas alternativas)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/tu-teams-webhook

# ==========================================
# COMPLIANCE Y AUDITORÍA
# ==========================================

# Configuración de auditoría HIPAA
AUDIT_ENABLED=true
AUDIT_LOG_LEVEL=info
AUDIT_RETENTION_DAYS=2555
AUDIT_LOG_PHI=true
AUDIT_WEBHOOK_URL=https://tu-sistema-auditoria.com/webhook

# ==========================================
# SEGURIDAD ADICIONAL
# ==========================================

# Configuración de CORS
CORS_ORIGIN=https://app.altamedica.com,https://doctors.altamedica.com,https://patients.altamedica.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=5
RATE_LIMIT_MEDICAL=30

# ==========================================
# FHIR Y ESTÁNDARES MÉDICOS
# ==========================================

# Servidor FHIR R4
FHIR_SERVER_URL=https://tu-servidor-fhir.com/fhir
FHIR_API_KEY=tu_fhir_api_key
FHIR_TENANT_ID=tu_tenant_fhir

# HL7 Integration
HL7_ENDPOINT=https://tu-hl7-endpoint.com
HL7_USERNAME=tu_hl7_username
HL7_PASSWORD=tu_hl7_password

# ==========================================
# PAGOS Y FACTURACIÓN
# ==========================================

# Stripe (Pagos)
STRIPE_PUBLISHABLE_KEY=pk_live_tu_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_tu_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_tu_stripe_webhook_secret

# Conekta (México)
CONEKTA_PUBLIC_KEY=key_tu_conekta_public_key
CONEKTA_PRIVATE_KEY=key_tu_conekta_private_key

# ==========================================
# DESARROLLO Y TESTING
# ==========================================

# Solo para desarrollo - NO usar en producción
ENABLE_DEBUG_LOGS=false
MOCK_EXTERNAL_APIS=false
SKIP_AUTH_IN_DEV=false

# Testing
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/altamedica_test

# ==========================================
# CERTIFICADOS SSL/TLS
# ==========================================

# Certificados para HTTPS (en producción usar AWS Certificate Manager o Let's Encrypt)
SSL_CERT_PATH=/path/to/ssl/certificate.crt
SSL_KEY_PATH=/path/to/ssl/private.key
SSL_CA_PATH=/path/to/ssl/ca-bundle.crt

# ==========================================
# BACKUP Y RECUPERACIÓN
# ==========================================

# Configuración de backup automático
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=altamedica-backups
BACKUP_ENCRYPTION_KEY=USAR_CLAVE_DIFERENTE_PARA_BACKUPS

# ==========================================
# CONFIGURACIÓN DE DOMINIO
# ==========================================

# URLs de producción
API_BASE_URL=https://api.altamedica.com
WEB_APP_URL=https://app.altamedica.com
DOCTORS_APP_URL=https://doctors.altamedica.com
PATIENTS_APP_URL=https://patients.altamedica.com
ADMIN_APP_URL=https://admin.altamedica.com

# CDN
CDN_URL=https://cdn.altamedica.com

# ==========================================
# CONFIGURACIÓN DE TIMEZONE
# ==========================================
TZ=America/Mexico_City
DEFAULT_LOCALE=es-MX
SUPPORTED_LOCALES=es-MX,en-US

# ==========================================
# LÍMITES DE RECURSOS
# ==========================================

# Límites de memoria y CPU
NODE_OPTIONS=--max-old-space-size=4096
UV_THREADPOOL_SIZE=16

# Límites de archivos
MAX_FILE_SIZE=10MB
MAX_FILES_PER_UPLOAD=5
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx

# ==========================================
# WEBSOCKETS
# ==========================================
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=3001
WEBSOCKET_PATH=/socket.io

# ==========================================
# CONFIGURACIÓN DE SALUD
# ==========================================

# Health checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60000
HEALTH_CHECK_TIMEOUT=5000

# ==========================================
# NOTIFICACIONES DE EMERGENCIA
# ==========================================

# Números y emails para emergencias médicas
EMERGENCY_PHONE_NUMBERS=+52-555-EMERGENCIA,+52-555-BACKUP
EMERGENCY_EMAIL_ADDRESSES=emergencias@altamedica.com,soporte@altamedica.com

# ==========================================
# CONFIGURACIÓN DE LOGS
# ==========================================

# Configuración de logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/altamedica/app.log
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10

# ==========================================
# CONFIGURACIÓN DE CACHE
# ==========================================

# Cache de aplicación
CACHE_TTL=3600
CACHE_MAX_SIZE=100MB
CACHE_STRATEGY=lru

# ==========================================
# FIN DE CONFIGURACIÓN
# ==========================================

# IMPORTANTE: 
# 1. NUNCA commitear este archivo con valores reales a Git
# 2. Usar gestores de secretos en producción (AWS Secrets Manager, etc.)
# 3. Rotar claves regularmente
# 4. Auditar acceso a variables de entorno
# 5. Usar HTTPS en todos los endpoints de producción
