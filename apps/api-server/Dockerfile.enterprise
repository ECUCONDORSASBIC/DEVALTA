# ALTAMEDICA API Server - Production Dockerfile
# Optimized for telemedicine, AI medical analysis, and real-time communication

FROM node:22-alpine AS base
RUN apk add --no-cache dumb-init curl ffmpeg imagemagick
RUN addgroup -g 1001 -S nodejs && adduser -S altamedica -u 1001 -G nodejs
WORKDIR /app
USER altamedica

# Dependencies stage
FROM base AS deps
COPY --chown=altamedica:nodejs package*.json ./
RUN npm ci --only=production --frozen-lockfile && npm cache clean --force

# Build stage
FROM base AS build
COPY --chown=altamedica:nodejs package*.json ./
RUN npm ci --frozen-lockfile
COPY --chown=altamedica:nodejs . .
RUN npm run build

# Runtime stage
FROM base AS runtime
COPY --from=deps --chown=altamedica:nodejs /app/node_modules ./node_modules
COPY --from=build --chown=altamedica:nodejs /app/.next ./.next
COPY --from=build --chown=altamedica:nodejs /app/public ./public
COPY --from=build --chown=altamedica:nodejs /app/package.json ./package.json

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3001/api/health || exit 1

EXPOSE 3001 8080 10000-10100/udp

ENV NODE_ENV=production
ENV PORT=3001
ENV NEXT_TELEMETRY_DISABLED=1

USER altamedica
ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "start"]
