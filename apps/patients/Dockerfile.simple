# 👥 ALTAMEDICA Patients App - Simple Production Dockerfile
FROM node:20-alpine

# Instalar pnpm y dependencias básicas
RUN apk add --no-cache curl bash dumb-init
RUN npm install -g pnpm@10.13.1

# Crear usuario no-root
RUN addgroup -g 1001 -S altamedica && adduser -S altamedica -u 1001 -G altamedica

WORKDIR /app
RUN chown altamedica:altamedica /app

# Cambiar a usuario no-root
USER altamedica

# Copiar package.json y workspace config
COPY --chown=altamedica:altamedica package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copiar solo la aplicación patients y sus dependencias directas
COPY --chown=altamedica:altamedica apps/patients/ ./apps/patients/

# Instalar solo las dependencias de la app patients
WORKDIR /app/apps/patients
RUN pnpm install --frozen-lockfile --prod

# Construir la aplicación
RUN pnpm build

# Exponer puerto
EXPOSE 3003

# Variables de entorno
ENV NODE_ENV=production
ENV PORT=3003
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3003/ || exit 1

# Comando de inicio
ENTRYPOINT ["dumb-init", "--"]
CMD ["pnpm", "start"]