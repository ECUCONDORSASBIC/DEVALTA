{
  "name": "@altamedica/patients",
  "version": "1.0.0",
  "description": "ALTAMEDICA Patients Management - Patient portal and records",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf .next dist coverage node_modules"
  },
  "dependencies": {
    "@altamedica/core": "workspace:*",
    "@altamedica/firebase": "workspace:*",
    "@altamedica/shared": "workspace:*",
    "@altamedica/types": "workspace:*",
    "@altamedica/ui": "workspace:*",
    "axios": "^1.7.2",
    "lucide-react": "^0.294.0",
    "next": "^15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.4.1",
    "@next/eslint-plugin-next": "^15.3.4",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20.19.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.8"
  }
}