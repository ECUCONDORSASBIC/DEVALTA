  "shortcuts": [
    {
      "name": "Nueva Cita",
      "short_name": "Cita",
      "description": "Agendar una nueva cita médica",
      "url": "/appointments/new",
      "icons": [
        {
          "src": "/icons/shortcut-appointment.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Telemedicina",
      "short_name": "Video",
      "description": "Iniciar sesión de telemedicina",
      "url": "/telemedicine",
      "icons": [
        {
          "src": "/icons/shortcut-telemedicine.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Mis Recetas",
      "short_name": "Recetas",
      "description": "Ver mis recetas médicas",
      "url": "/prescriptions",
      "icons": [
        {
          "src": "/icons/shortcut-prescriptions.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Resultados de Laboratorio",
      "short_name": "Labs",
      "description": "Ver resultados de laboratorio",
      "url": "/lab-results",
      "icons": [
        {
          "src": "/icons/shortcut-lab-results.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/home-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Pantalla principal de AltaMedica"
    },
    {
      "src": "/screenshots/telemedicine-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Sesión de telemedicina"
    },
    {
      "src": "/screenshots/appointments-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Gestión de citas"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+altamedica",
      "url": "/?protocol=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/upload",
      "accept": {
        "image/*": [".jpg", ".jpeg", ".png", ".gif"],
        "application/pdf": [".pdf"],
        "text/*": [".txt", ".md"]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "application/pdf", "text/*"]
        }
      ]
    }
  },
  "handle_links": "preferred",
  "capture_links": "existing-client-navigate"
} 