/**
 * Configuración de Variables de Entorno para Sistema Médico Altamedica
 * IMPORTANTE: Copiar a .env.local y configurar valores reales en producción
 */

# Firebase Configuration (Reemplazar con valores reales)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key-replace-in-production
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=altamedica-demo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=altamedica-demo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=altamedica-demo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:demo123
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-DEMO123

# Claves de Cifrado (GENERAR NUEVAS EN PRODUCCIÓN)
NEXT_PUBLIC_ENCRYPTION_KEY=altamedica-encryption-key-2024-secure-replace-in-production
NEXT_PUBLIC_SIGNING_KEY=altamedica-signing-key-2024-secure-replace-in-production

# Configuración de la Aplicación
NEXT_PUBLIC_APP_VERSION=2.0.0
NEXT_PUBLIC_BUILD_DATE=2024-01-01T00:00:00.000Z
NEXT_PUBLIC_ENVIRONMENT=development

# URLs de API Externa (Configurar según entorno)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_FHIR_SERVER_URL=https://demo-fhir-server.com/fhir

# Configuración HIPAA/GDPR
NEXT_PUBLIC_ENABLE_AUDIT_LOGGING=true
NEXT_PUBLIC_DATA_RETENTION_DAYS=2555  # 7 años
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30

# Configuración de Emuladores Firebase (Solo desarrollo)
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_EMULATOR_AUTH_PORT=9099
NEXT_PUBLIC_EMULATOR_FIRESTORE_PORT=8080
NEXT_PUBLIC_EMULATOR_STORAGE_PORT=9199
NEXT_PUBLIC_EMULATOR_FUNCTIONS_PORT=5001

# Configuración de Notificaciones
NEXT_PUBLIC_VAPID_PUBLIC_KEY=demo-vapid-key-replace-in-production

# URLs de Servicios Externos
NEXT_PUBLIC_TWILIO_ACCOUNT_SID=demo-twilio-sid
NEXT_PUBLIC_SENDGRID_API_KEY=demo-sendgrid-key

# Configuración de Logging y Monitoreo
NEXT_PUBLIC_SENTRY_DSN=https://demo-sentry-dsn@sentry.io/project
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# IMPORTANTE: 
# 1. Nunca commitear las claves reales al repositorio
# 2. Usar un sistema de gestión de secretos en producción (AWS Secrets Manager, Azure Key Vault, etc.)
# 3. Rotar las claves de cifrado periódicamente
# 4. Configurar diferentes valores para desarrollo, staging y producción
# 5. Habilitar auditoría de acceso a variables de entorno en producción
