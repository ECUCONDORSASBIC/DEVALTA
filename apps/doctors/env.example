# Configuración de Grok 3 API
NEXT_PUBLIC_GROK_API_KEY=your-grok-api-key-here

# Configuración del servidor de señalización
SIGNALING_PORT=3001
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:3001

# Configuración de WebRTC
NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302