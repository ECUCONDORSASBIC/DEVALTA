{
  "name": "@altamedica/doctors",
  "version": "1.0.0",
  "description": "ALTAMEDICA Doctors Management - Medical professionals platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "signaling": "node scripts/start-signaling.js",
    "dev:full": "concurrently \"pnpm signaling\" \"pnpm dev\"",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf .next dist coverage"
  },
  "dependencies": {
    "@altamedica/core": "workspace:*",
    "@altamedica/firebase": "workspace:*",
    "@altamedica/shared": "workspace:*",
    "@altamedica/types": "workspace:*",
    "@altamedica/ui": "workspace:*",
    "@anthropic-ai/sdk": "^0.55.1",
    "@modelcontextprotocol/sdk": "^1.13.2",
    "@next/bundle-analyzer": "^15.4.1",
    "@types/offscreencanvas": "^2019.7.3",
    "axios": "^1.10.0",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "crypto-js": "^4.2.0",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.294.0",
    "mercadopago": "^2.0.0",
    "next": "^15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.3.4",
    "@types/node": "^20.19.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.8"
  }
}