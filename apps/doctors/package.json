{
  "name": "@altamedica/doctors",
  "version": "1.0.0",
  "description": "ALTAMEDICA Doctors Management - Medical professionals platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "npx next build",
    "start": "next start --port 3002",
    "signaling": "node scripts/start-signaling.js",
    "dev:full": "concurrently \"pnpm signaling\" \"pnpm dev\"",
    "dev:e2e": "concurrently \"pnpm --filter api-server dev\" \"pnpm dev\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next dist coverage"
  },
  "dependencies": {
    "@altamedica/auth": "workspace:*",
    "@altamedica/database": "workspace:*",
    "@altamedica/firebase-config": "workspace:^",
    "@altamedica/hooks": "workspace:*",
    "@altamedica/marketplace-hooks": "workspace:*",
    "@altamedica/medical": "workspace:*",
    "@altamedica/medical-services": "workspace:*",
    "@altamedica/patient-services": "workspace:*",
    "@altamedica/shared": "workspace:*",
    "@altamedica/ui": "workspace:*",
    "@anthropic-ai/sdk": "^0.55.1",
    "@modelcontextprotocol/sdk": "^1.13.2",
    "@next/bundle-analyzer": "^15.4.1",
    "@tanstack/react-query": "^5.17.0",
    "@tanstack/react-query-devtools": "^5.17.0",
    "@types/offscreencanvas": "^2019.7.3",
    "axios": "^1.10.0",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.536.0",
    "next": "15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.18.0",
    "zod": "^3.22.4",
    "@altamedica/utils": "workspace:*"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.3.4",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.19.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3"
  }
