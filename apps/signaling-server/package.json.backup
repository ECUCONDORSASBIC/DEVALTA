{
  "name": "@altamedica/signaling-server",
  "version": "1.0.0",
  "description": "WebRTC signaling server for Altamedica telemedicine platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:watch": "vitest watch"
  },
  "keywords": ["webrtc", "signaling", "telemedicine", "socket.io"],
  "author": "Altamedica",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "redis": "^4.7.0",
    "winston": "^3.17.0",
    "express-rate-limit": "^7.5.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.5",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@vitest/ui": "^2.1.8"
  },
  "packageManager": "pnpm@10.13.1"
}
