                        <p className="font-medium text-yellow-800">12 pacientes con citas vencidas</p>
                        <p className="text-sm text-yellow-700">Más de 30 días sin seguimiento</p>
                      </div>
                    </div>
                    <div className="flex items-center gap-3 p-3 bg-blue-50 border border-blue-200 rounded-lg">
                      <Video className="h-5 w-5 text-blue-600" />
                      <div>
                        <p className="font-medium text-blue-800">5 sesiones de telemedicina activas</p>
                        <p className="text-sm text-blue-700">Dr. Pérez atendiendo a Roberto Silva</p>
                      </div>
                    </div>
                    <div className="flex items-center gap-3 p-3 bg-green-50 border border-green-200 rounded-lg">
                      <CheckCircle2 className="h-5 w-5 text-green-600" />
                      <div>
                        <p className="font-medium text-green-800">67 citas completadas hoy</p>
                        <p className="text-sm text-green-700">22 pendientes para el resto del día</p>
                      </div>
                    </div>
                    <div className="flex items-center gap-3 p-3 bg-purple-50 border border-purple-200 rounded-lg">
