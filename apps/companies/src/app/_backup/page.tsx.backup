                            <p className="font-medium text-gray-900">{patient.name}</p>
                            <p className="text-sm text-gray-600">ID: {patient.id}</p>
                            <p className="text-xs text-gray-500">{patient.bloodType} • BMI: {patient.bmi}</p>
                          </div>
                        </td>
                        <td className="py-3 px-4">
                          <div>
                            <p className="font-medium">{patient.age} años</p>
                            <p className="text-sm text-gray-600 capitalize">{patient.gender}</p>
                          </div>
                        </td>
                        <td className="py-3 px-4">
                          <div>
                            <p className="font-medium text-gray-900">{patient.primaryDiagnosis}</p>
                            <p className="text-sm text-gray-600">{patient.comorbidities.join(', ')}</p>
                          </div>
                        </td>
                        <td className="py-3 px-4">
                          <Badge className={
                            patient.riskLevel === 'high' ? 'bg-red-100 text-red-800' :
                            patient.riskLevel === 'medium' ? 'bg-yellow-100 text-yellow-800' :
                            'bg-green-100 text-green-800'
                          }>
                            {patient.riskLevel === 'high' ? 'Alto' : 
                             patient.riskLevel === 'medium' ? 'Medio' : 'Bajo'}
                          </Badge>
                        </td>
                        <td className="py-3 px-4">{patient.lastVisit}</td>
                        <td className="py-3 px-4">{patient.nextAppointment}</td>
                        <td className="py-3 px-4">
                          <div className="flex items-center gap-2">
                            <div className="w-16 bg-gray-200 rounded-full h-2">
                              <div 
                                className={`h-2 rounded-full ${
                                  patient.healthScore >= 80 ? 'bg-green-600' :
                                  patient.healthScore >= 60 ? 'bg-yellow-600' : 'bg-red-600'
                                }`}
                                style={{ width: `${patient.healthScore}%` }}
                              ></div>
                            </div>
                            <span className="text-sm font-medium">{patient.healthScore}%</span>
                          </div>
                        </td>
                        <td className="py-3 px-4">
                          <div className="flex gap-2">
                            <Button size="sm" variant="outline" className="text-sky-600 border-sky-200 hover:bg-sky-50">
                              <Eye className="w-3 h-3" />
                            </Button>
                            <Button size="sm" variant="outline" className="text-blue-600 border-blue-200 hover:bg-blue-50">
                              <Video className="w-3 h-3" />
                            </Button>
                            <Button size="sm" variant="outline" className="text-green-600 border-green-200 hover:bg-green-50">
                              <Calendar className="w-3 h-3" />
                            </Button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </CardContent>
          </Card>
        )}

        {selectedView === 'doctors' && (
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <UserCheck className="h-5 w-5 text-blue-600" />
                Gestión de Médicos
              </CardTitle>
            </CardHeader>
            <CardContent>
              <div className="overflow-x-auto">
                <table className="w-full">
                  <thead>
                    <tr className="border-b border-blue-200">
                      <th className="text-left py-3 px-4">Médico</th>
                      <th className="text-left py-3 px-4">Especialidad</th>
                      <th className="text-left py-3 px-4">Estado</th>
                      <th className="text-left py-3 px-4">Telemedicina</th>
                      <th className="text-left py-3 px-4">Citas Hoy</th>
                      <th className="text-left py-3 px-4">Rating</th>
                      <th className="text-left py-3 px-4">Sesión Actual</th>
                      <th className="text-left py-3 px-4">Acciones</th>
                    </tr>
                  </thead>
                  <tbody>
                    {doctors.map((doctor) => (
                      <tr key={doctor.id} className="border-b hover:bg-blue-50 transition-colors">
                        <td className="py-3 px-4">
                          <div>
                            <p className="font-medium text-gray-900">{doctor.name}</p>
                            <p className="text-sm text-gray-600">ID: {doctor.id}</p>
                            <p className="text-xs text-gray-500">{doctor.experience} años exp.</p>
                          </div>
                        </td>
                        <td className="py-3 px-4">
                          <div>
                            <p className="font-medium text-gray-900">{doctor.specialty}</p>
                            {doctor.subSpecialty && (
                              <p className="text-sm text-gray-600">{doctor.subSpecialty}</p>
                            )}
                          </div>
                        </td>
                        <td className="py-3 px-4">
                          <Badge className={
                            doctor.status === 'online' ? 'bg-green-100 text-green-800' :
                            doctor.status === 'busy' ? 'bg-yellow-100 text-yellow-800' :
                            doctor.status === 'offline' ? 'bg-gray-100 text-gray-800' :
                            'bg-blue-100 text-blue-800'
                          }>
                            {doctor.status === 'online' ? 'Online' :
                             doctor.status === 'busy' ? 'Ocupado' :
                             doctor.status === 'offline' ? 'Offline' : 'Ausente'}
                          </Badge>
                        </td>
                        <td className="py-3 px-4">
                          <Badge className={doctor.telemedicineEnabled ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}>
                            {doctor.telemedicineEnabled ? 'Habilitado' : 'No disponible'}
                          </Badge>
                        </td>
                        <td className="py-3 px-4">
                          <div className="text-center">
                            <p className="font-medium text-gray-900">{doctor.appointmentsToday}</p>
                            <p className="text-xs text-gray-500">hoy</p>
                          </div>
                        </td>
                        <td className="py-3 px-4">
                          <div className="flex items-center gap-1">
                            <span className="font-medium">{doctor.rating}</span>
                            <Star className="h-4 w-4 text-yellow-500 fill-current" />
                            <span className="text-xs text-gray-500">({doctor.performanceMetrics.patientsSeen})</span>
                          </div>
                        </td>
                        <td className="py-3 px-4">
                          {doctor.currentSession ? (
                            <div className="text-sm">
                              <p className="font-medium text-gray-900">{doctor.currentSession.patientName}</p>
                              <p className="text-xs text-gray-600">{doctor.currentSession.sessionType}</p>
                              <p className="text-xs text-gray-500">Desde {doctor.currentSession.startTime}</p>
                            </div>
                          ) : (
                            <span className="text-sm text-gray-500">Sin sesión</span>
                          )}
                        </td>
                        <td className="py-3 px-4">
                          <div className="flex gap-2">
                            <Button size="sm" variant="outline" className="text-blue-600 border-blue-200 hover:bg-blue-50">
                              <Eye className="w-3 h-3" />
                            </Button>
                            {doctor.telemedicineEnabled && (
                              <Button size="sm" variant="outline" className="text-green-600 border-green-200 hover:bg-green-50">
                                <Video className="w-3 h-3" />
                              </Button>
                            )}
                            <Button size="sm" variant="outline" className="text-purple-600 border-purple-200 hover:bg-purple-50">
                              <MessageSquare className="w-3 h-3" />
                            </Button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </CardContent>
          </Card>
        )}

        {selectedView === 'telemedicine' && (
          <div className="space-y-6">
            {/* Estadísticas de Telemedicina */}
            <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
              <Card className="border-purple-200 hover:shadow-lg transition-shadow">
                <CardContent className="p-6">
                  <div className="flex items-center">
                    <Video className="w-8 h-8 text-purple-600 mr-3" />
                    <div>
                      <p className="text-sm text-gray-600">Sesiones Activas</p>
                      <p className="text-2xl font-bold text-purple-700">5</p>
                    </div>
                  </div>
                </CardContent>
              </Card>
              <Card className="border-green-200 hover:shadow-lg transition-shadow">
                <CardContent className="p-6">
                  <div className="flex items-center">
                    <Wifi className="w-8 h-8 text-green-600 mr-3" />
                    <div>
                      <p className="text-sm text-gray-600">Conexión Estable</p>
                      <p className="text-2xl font-bold text-green-700">98%</p>
                    </div>
                  </div>
                </CardContent>
              </Card>
              <Card className="border-blue-200 hover:shadow-lg transition-shadow">
                <CardContent className="p-6">
                  <div className="flex items-center">
                    <Clock className="w-8 h-8 text-blue-600 mr-3" />
                    <div>
                      <p className="text-sm text-gray-600">Tiempo Promedio</p>
                      <p className="text-2xl font-bold text-blue-700">24 min</p>
                    </div>
                  </div>
                </CardContent>
              </Card>
              <Card className="border-orange-200 hover:shadow-lg transition-shadow">
                <CardContent className="p-6">
                  <div className="flex items-center">
                    <Users className="w-8 h-8 text-orange-600 mr-3" />
                    <div>
                      <p className="text-sm text-gray-600">Médicos Online</p>
                      <p className="text-2xl font-bold text-orange-700">8</p>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </div>

            {/* Sesiones Activas */}
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <Video className="h-5 w-5 text-purple-600" />
                  Sesiones de Telemedicina Activas
                </CardTitle>
              </CardHeader>
              <CardContent>
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                  {doctors.filter(d => d.currentSession).map((doctor) => (
                    <div key={doctor.id} className="border border-purple-200 rounded-lg p-4 bg-purple-50">
                      <div className="flex items-center justify-between mb-3">
                        <div className="flex items-center gap-2">
                          <div className="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                          <span className="text-sm font-medium text-purple-800">En Sesión</span>
                        </div>
                        <Badge className="bg-purple-100 text-purple-800">
                          {doctor.currentSession?.sessionType === 'video' ? 'Video' : 
                           doctor.currentSession?.sessionType === 'audio' ? 'Audio' : 'Chat'}
                        </Badge>
                      </div>
                      <div className="space-y-2">
                        <div>
                          <p className="font-medium text-gray-900">{doctor.name}</p>
                          <p className="text-sm text-gray-600">{doctor.specialty}</p>
                        </div>
                        <div className="border-t border-purple-200 pt-2">
                          <p className="text-sm font-medium text-gray-900">Paciente: {doctor.currentSession?.patientName}</p>
                          <p className="text-xs text-gray-600">Desde: {doctor.currentSession?.startTime}</p>
                        </div>
                        <div className="flex gap-2 pt-2">
                          <Button size="sm" className="bg-purple-600 hover:bg-purple-700 text-white">
                            <Eye className="w-3 h-3 mr-1" />
                            Ver Sesión
                          </Button>
                          <Button size="sm" variant="outline" className="border-purple-200 text-purple-600">
                            <MessageSquare className="w-3 h-3 mr-1" />
                            Chat
                          </Button>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </CardContent>
            </Card>

            {/* Calidad de Conexión */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <Card>
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <SignalHigh className="h-5 w-5 text-green-600" />
                    Calidad de Conexión
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <div className="space-y-4">
                    <div className="flex items-center justify-between">
                      <span className="text-sm text-gray-600">Ancho de Banda</span>
                      <div className="flex items-center gap-2">
                        <SignalHigh className="w-4 h-4 text-green-600" />
                        <span className="font-medium">Excelente</span>
                      </div>
                    </div>
                    <div className="flex items-center justify-between">
                      <span className="text-sm text-gray-600">Latencia</span>
                      <div className="flex items-center gap-2">
                        <SignalMedium className="w-4 h-4 text-yellow-600" />
                        <span className="font-medium">45ms</span>
                      </div>
                    </div>
                    <div className="flex items-center justify-between">
                      <span className="text-sm text-gray-600">Paquetes Perdidos</span>
                      <div className="flex items-center gap-2">
                        <SignalHigh className="w-4 h-4 text-green-600" />
                        <span className="font-medium">0.1%</span>
                      </div>
                    </div>
                  </div>
                </CardContent>
              </Card>

              <Card>
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <ActivitySquare className="h-5 w-5 text-blue-600" />
                    Métricas de Rendimiento
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <div className="space-y-4">
                    <div>
                      <div className="flex justify-between items-center mb-2">
                        <span className="text-sm text-gray-600">Satisfacción Pacientes</span>
                        <span className="font-medium">96%</span>
                      </div>
                      <div className="w-full bg-gray-200 rounded-full h-2">
                        <div className="bg-green-600 h-2 rounded-full" style={{ width: '96%' }}></div>
                      </div>
                    </div>
                    <div>
                      <div className="flex justify-between items-center mb-2">
                        <span className="text-sm text-gray-600">Tiempo de Respuesta</span>
                        <span className="font-medium">2.3s</span>
                      </div>
                      <div className="w-full bg-gray-200 rounded-full h-2">
                        <div className="bg-blue-600 h-2 rounded-full" style={{ width: '85%' }}></div>
                      </div>
                    </div>
                    <div>
                      <div className="flex justify-between items-center mb-2">
                        <span className="text-sm text-gray-600">Uptime del Sistema</span>
                        <span className="font-medium">99.9%</span>
                      </div>
                      <div className="w-full bg-gray-200 rounded-full h-2">
                        <div className="bg-purple-600 h-2 rounded-full" style={{ width: '99.9%' }}></div>
                      </div>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </div>
          </div>
        )}

        {selectedView === 'equipment' && (
          <div className="space-y-6">
            {/* Estadísticas de Equipamiento */}
            <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
              <Card className="border-blue-200 hover:shadow-lg transition-shadow">
                <CardContent className="p-6">
                  <div className="flex items-center">
                    <Monitor className="w-8 h-8 text-blue-600 mr-3" />
                    <div>
                      <p className="text-sm text-gray-600">Equipos Operativos</p>
                      <p className="text-2xl font-bold text-blue-700">
                        {equipment.filter(e => e.status === 'operational').length}
                      </p>
                    </div>
                  </div>
                </CardContent>
              </Card>
              <Card className="border-yellow-200 hover:shadow-lg transition-shadow">
                <CardContent className="p-6">
                  <div className="flex items-center">
                    <Wrench className="w-8 h-8 text-yellow-600 mr-3" />
                    <div>
                      <p className="text-sm text-gray-600">En Mantenimiento</p>
                      <p className="text-2xl font-bold text-yellow-700">
                        {equipment.filter(e => e.status === 'maintenance').length}
                      </p>
                    </div>
                  </div>
                </CardContent>
              </Card>
              <Card className="border-red-200 hover:shadow-lg transition-shadow">
                <CardContent className="p-6">
                  <div className="flex items-center">
                    <AlertTriangle className="w-8 h-8 text-red-600 mr-3" />
                    <div>
                      <p className="text-sm text-gray-600">Críticos</p>
                      <p className="text-2xl font-bold text-red-700">
                        {equipment.filter(e => e.criticalLevel === 'critical').length}
                      </p>
                    </div>
                  </div>
                </CardContent>
              </Card>
              <Card className="border-green-200 hover:shadow-lg transition-shadow">
                <CardContent className="p-6">
                  <div className="flex items-center">
                    <DollarSign className="w-8 h-8 text-green-600 mr-3" />
                    <div>
                      <p className="text-sm text-gray-600">Valor Total</p>
                      <p className="text-2xl font-bold text-green-700">
                        ${equipment.reduce((sum, e) => sum + e.cost, 0).toLocaleString()}
                      </p>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </div>

            {/* Alertas de Equipamiento */}
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <AlertTriangle className="h-5 w-5 text-red-600" />
                  Alertas de Equipamiento
                </CardTitle>
              </CardHeader>
              <CardContent>
                <div className="space-y-3">
                  {equipment.filter(e => e.alerts.length > 0).map((equipment) => (
                    <div key={equipment.id} className="flex items-center gap-3 p-3 bg-red-50 border border-red-200 rounded-lg">
                      <div className={`w-3 h-3 rounded-full ${
                        equipment.criticalLevel === 'critical' ? 'bg-red-500' :
                        equipment.criticalLevel === 'high' ? 'bg-orange-500' :
                        equipment.criticalLevel === 'medium' ? 'bg-yellow-500' : 'bg-green-500'
                      }`}></div>
                      <div className="flex-1">
                        <p className="font-medium text-red-800">{equipment.name}</p>
                        <p className="text-sm text-red-700">{equipment.alerts.join(', ')}</p>
                      </div>
                      <Badge className={getEquipmentStatusColor(equipment.status)}>
                        {equipment.status === 'operational' ? 'Operativo' :
                         equipment.status === 'maintenance' ? 'Mantenimiento' :
                         equipment.status === 'out_of_service' ? 'Fuera de Servicio' :
                         equipment.status === 'calibration_due' ? 'Calibración Pendiente' : 'Expirado'}
                      </Badge>
                    </div>
                  ))}
                </div>
              </CardContent>
            </Card>

            {/* Lista de Equipamiento */}
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <Monitor className="h-5 w-5 text-blue-600" />
                  Gestión de Equipamiento Médico
                </CardTitle>
              </CardHeader>
              <CardContent>
                <div className="overflow-x-auto">
                  <table className="w-full">
                    <thead>
                      <tr className="border-b border-blue-200">
                        <th className="text-left py-3 px-4">Equipo</th>
                        <th className="text-left py-3 px-4">Tipo</th>
                        <th className="text-left py-3 px-4">Ubicación</th>
                        <th className="text-left py-3 px-4">Estado</th>
                        <th className="text-left py-3 px-4">Utilización</th>
                        <th className="text-left py-3 px-4">Próximo Mantenimiento</th>
                        <th className="text-left py-3 px-4">Nivel Crítico</th>
                        <th className="text-left py-3 px-4">Acciones</th>
                      </tr>
                    </thead>
                    <tbody>
                      {equipment.map((equipment) => {
                        const TypeIcon = getEquipmentTypeIcon(equipment.type);
                        return (
                          <tr key={equipment.id} className="border-b hover:bg-blue-50 transition-colors">
                            <td className="py-3 px-4">
                              <div className="flex items-center gap-3">
                                <div className="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                                  <TypeIcon className="w-5 h-5 text-blue-600" />
                                </div>
                                <div>
                                  <p className="font-medium text-gray-900">{equipment.name}</p>
                                  <p className="text-sm text-gray-600">{equipment.brand} {equipment.model}</p>
                                  <p className="text-xs text-gray-500">ID: {equipment.id}</p>
                                </div>
                              </div>
                            </td>
                            <td className="py-3 px-4">
                              <div>
                                <p className="font-medium text-gray-900">{equipment.category}</p>
                                <p className="text-sm text-gray-600 capitalize">{equipment.type}</p>
                              </div>
                            </td>
                            <td className="py-3 px-4">
                              <div>
                                <p className="font-medium text-gray-900">{equipment.location}</p>
                                <p className="text-sm text-gray-600">{equipment.department}</p>
                              </div>
                            </td>
                            <td className="py-3 px-4">
                              <Badge className={getEquipmentStatusColor(equipment.status)}>
                                {equipment.status === 'operational' ? 'Operativo' :
                                 equipment.status === 'maintenance' ? 'Mantenimiento' :
                                 equipment.status === 'out_of_service' ? 'Fuera de Servicio' :
                                 equipment.status === 'calibration_due' ? 'Calibración Pendiente' : 'Expirado'}
                              </Badge>
                            </td>
                            <td className="py-3 px-4">
                              <div className="flex items-center gap-2">
                                <div className="w-16 bg-gray-200 rounded-full h-2">
                                  <div 
                                    className={`h-2 rounded-full ${
                                      equipment.utilization >= 80 ? 'bg-green-600' :
                                      equipment.utilization >= 60 ? 'bg-yellow-600' : 'bg-blue-600'
                                    }`}
                                    style={{ width: `${equipment.utilization}%` }}
                                  ></div>
                                </div>
                                <span className="text-sm font-medium">{equipment.utilization}%</span>
                              </div>
                              <p className="text-xs text-gray-500">Uptime: {equipment.uptime}%</p>
                            </td>
                            <td className="py-3 px-4">
                              <div>
                                <p className="text-sm font-medium text-gray-900">{equipment.nextMaintenance}</p>
                                <p className="text-xs text-gray-500">Calibración: {equipment.nextCalibration}</p>
                              </div>
                            </td>
                            <td className="py-3 px-4">
                              <Badge className={getCriticalLevelColor(equipment.criticalLevel)}>
                                {equipment.criticalLevel === 'low' ? 'Bajo' :
                                 equipment.criticalLevel === 'medium' ? 'Medio' :
                                 equipment.criticalLevel === 'high' ? 'Alto' : 'Crítico'}
                              </Badge>
                            </td>
                            <td className="py-3 px-4">
                              <div className="flex gap-2">
                                <Button size="sm" variant="outline" className="text-blue-600 border-blue-200 hover:bg-blue-50">
                                  <Eye className="w-3 h-3" />
                                </Button>
                                <Button size="sm" variant="outline" className="text-green-600 border-green-200 hover:bg-green-50">
                                  <Wrench className="w-3 h-3" />
                                </Button>
                                <Button size="sm" variant="outline" className="text-purple-600 border-purple-200 hover:bg-purple-50">
                                  <Settings className="w-3 h-3" />
                                </Button>
                              </div>
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              </CardContent>
            </Card>

            {/* Análisis de Equipamiento */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <Card>
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <BarChart3 className="h-5 w-5 text-purple-600" />
                    Utilización por Tipo
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <div className="space-y-4">
                    {['imaging', 'monitoring', 'laboratory', 'therapeutic', 'diagnostic', 'surgical'].map((type) => {
                      const typeEquipment = equipment.filter(e => e.type === type);
                      const avgUtilization = typeEquipment.length > 0 
                        ? typeEquipment.reduce((sum, e) => sum + e.utilization, 0) / typeEquipment.length 
                        : 0;
                      return (
                        <div key={type} className="flex justify-between items-center">
                          <span className="text-sm text-gray-600 capitalize">{type}</span>
                          <div className="flex items-center gap-2">
                            <div className="w-20 bg-gray-200 rounded-full h-2">
                              <div 
                                className="bg-purple-600 h-2 rounded-full" 
                                style={{ width: `${avgUtilization}%` }}
                              ></div>
                            </div>
                            <span className="font-medium text-sm">{avgUtilization.toFixed(1)}%</span>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </CardContent>
              </Card>

              <Card>
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <TrendingUp className="h-5 w-5 text-green-600" />
                    Costos de Mantenimiento
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <div className="space-y-4">
                    {equipment.slice(0, 5).map((equipment) => {
                      const totalMaintenanceCost = equipment.maintenanceHistory.reduce((sum, m) => sum + m.cost, 0);
                      return (
                        <div key={equipment.id} className="flex justify-between items-center">
                          <div>
                            <p className="text-sm font-medium text-gray-900">{equipment.name}</p>
                            <p className="text-xs text-gray-600">{equipment.maintenanceHistory.length} mantenimientos</p>
                          </div>
                          <span className="font-medium text-green-600">${totalMaintenanceCost.toLocaleString()}</span>
                        </div>
                      );
                    })}
                  </div>
                </CardContent>
              </Card>
            </div>
          </div>
        )}

        {selectedView === 'appointments' && (
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <Calendar className="h-5 w-5 text-green-600" />
                Gestión de Citas Médicas
              </CardTitle>
            </CardHeader>
            <CardContent>
              <div className="overflow-x-auto">
                <table className="w-full">
                  <thead>
                    <tr className="border-b border-green-200">
                      <th className="text-left py-3 px-4">Paciente</th>
                      <th className="text-left py-3 px-4">Médico</th>
                      <th className="text-left py-3 px-4">Fecha/Hora</th>
                      <th className="text-left py-3 px-4">Tipo</th>
                      <th className="text-left py-3 px-4">Especialidad</th>
                      <th className="text-left py-3 px-4">Estado</th>
                      <th className="text-left py-3 px-4">Signos Vitales</th>
                      <th className="text-left py-3 px-4">Acciones</th>
                    </tr>
                  </thead>
                  <tbody>
                    {appointments.map((appointment) => (
                      <tr key={appointment.id} className="border-b hover:bg-green-50 transition-colors">
                        <td className="py-3 px-4">
                          <div>
                            <p className="font-medium text-gray-900">{appointment.patientName}</p>
                            <p className="text-sm text-gray-600">ID: {appointment.patientId}</p>
                          </div>
                        </td>
                        <td className="py-3 px-4">
                          <div>
                            <p className="font-medium text-gray-900">{appointment.doctorName}</p>
                            <p className="text-sm text-gray-600">{appointment.specialty}</p>
                          </div>
                        </td>
                        <td className="py-3 px-4">
                          <div>
                            <p className="font-medium text-gray-900">{appointment.date}</p>
                            <p className="text-sm text-gray-600">{appointment.time}</p>
                            <p className="text-xs text-gray-500">{appointment.duration} min</p>
                          </div>
                        </td>
                        <td className="py-3 px-4">
                          <Badge className={
                            appointment.type === 'telemedicine_video' ? 'bg-purple-100 text-purple-800' :
                            appointment.type === 'telemedicine_audio' ? 'bg-blue-100 text-blue-800' :
                            appointment.type === 'in_person' ? 'bg-green-100 text-green-800' :
                            appointment.type === 'emergency' ? 'bg-red-100 text-red-800' :
                            'bg-gray-100 text-gray-800'
                          }>
                            {appointment.type === 'telemedicine_video' ? 'Telemedicina Video' :
                             appointment.type === 'telemedicine_audio' ? 'Telemedicina Audio' :
                             appointment.type === 'in_person' ? 'Presencial' :
                             appointment.type === 'emergency' ? 'Emergencia' : 'Seguimiento'}
                          </Badge>
                        </td>
                        <td className="py-3 px-4">
                          <span className="text-sm font-medium text-gray-900">{appointment.specialty}</span>
                        </td>
                        <td className="py-3 px-4">
                          <Badge className={
                            appointment.status === 'completed' ? 'bg-green-100 text-green-800' :
                            appointment.status === 'in_progress' ? 'bg-blue-100 text-blue-800' :
                            appointment.status === 'scheduled' ? 'bg-yellow-100 text-yellow-800' :
                            appointment.status === 'cancelled' ? 'bg-red-100 text-red-800' :
                            'bg-orange-100 text-orange-800'
                          }>
                            {appointment.status === 'completed' ? 'Completada' :
                             appointment.status === 'in_progress' ? 'En Progreso' :
                             appointment.status === 'scheduled' ? 'Programada' :
                             appointment.status === 'cancelled' ? 'Cancelada' : 'No Presentó'}
                          </Badge>
                        </td>
                        <td className="py-3 px-4">
                          {appointment.vitalSigns ? (
                            <div className="text-xs space-y-1">
                              <div className="flex justify-between">
                                <span>PA:</span>
                                <span className="font-medium">{appointment.vitalSigns.bloodPressure}</span>
                              </div>
                              <div className="flex justify-between">
                                <span>FC:</span>
                                <span className="font-medium">{appointment.vitalSigns.heartRate}</span>
                              </div>
                              <div className="flex justify-between">
                                <span>T:</span>
                                <span className="font-medium">{appointment.vitalSigns.temperature}°C</span>
                              </div>
                            </div>
                          ) : (
                            <span className="text-xs text-gray-500">No registrados</span>
                          )}
                        </td>
                        <td className="py-3 px-4">
                          <div className="flex gap-2">
                            <Button size="sm" variant="outline" className="text-green-600 border-green-200 hover:bg-green-50">
                              <Eye className="w-3 h-3" />
                            </Button>
                            {appointment.type.includes('telemedicine') && (
                              <Button size="sm" variant="outline" className="text-purple-600 border-purple-200 hover:bg-purple-50">
                                <Video className="w-3 h-3" />
                              </Button>
                            )}
                            <Button size="sm" variant="outline" className="text-blue-600 border-blue-200 hover:bg-blue-50">
                              <FileText className="w-3 h-3" />
                            </Button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </CardContent>
          </Card>
        )}

        {selectedView === 'analytics' && (
          <div className="space-y-6">
            {/* Análisis Demográfico de Pacientes */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <Card>
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <Users2 className="h-5 w-5 text-sky-600" />
                    Distribución por Edad
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <div className="space-y-4">
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">18-30 años</span>
                      <div className="flex items-center gap-2">
                        <div className="w-20 bg-gray-200 rounded-full h-2">
                          <div className="bg-sky-600 h-2 rounded-full" style={{ width: '25%' }}></div>
                        </div>
                        <span className="font-medium text-sm">25%</span>
                      </div>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">31-50 años</span>
                      <div className="flex items-center gap-2">
                        <div className="w-20 bg-gray-200 rounded-full h-2">
                          <div className="bg-blue-600 h-2 rounded-full" style={{ width: '40%' }}></div>
                        </div>
                        <span className="font-medium text-sm">40%</span>
                      </div>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">51-70 años</span>
                      <div className="flex items-center gap-2">
                        <div className="w-20 bg-gray-200 rounded-full h-2">
                          <div className="bg-purple-600 h-2 rounded-full" style={{ width: '30%' }}></div>
                        </div>
                        <span className="font-medium text-sm">30%</span>
                      </div>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">70+ años</span>
                      <div className="flex items-center gap-2">
                        <div className="w-20 bg-gray-200 rounded-full h-2">
                          <div className="bg-green-600 h-2 rounded-full" style={{ width: '5%' }}></div>
                        </div>
                        <span className="font-medium text-sm">5%</span>
                      </div>
                    </div>
                  </div>
                </CardContent>
              </Card>

              <Card>
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <PieChartIcon className="h-5 w-5 text-green-600" />
                    Diagnósticos Principales
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <div className="space-y-4">
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">Diabetes</span>
                      <div className="flex items-center gap-2">
                        <div className="w-20 bg-gray-200 rounded-full h-2">
                          <div className="bg-red-600 h-2 rounded-full" style={{ width: '35%' }}></div>
                        </div>
                        <span className="font-medium text-sm">35%</span>
                      </div>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">Hipertensión</span>
                      <div className="flex items-center gap-2">
                        <div className="w-20 bg-gray-200 rounded-full h-2">
                          <div className="bg-orange-600 h-2 rounded-full" style={{ width: '28%' }}></div>
                        </div>
                        <span className="font-medium text-sm">28%</span>
                      </div>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">Asma</span>
                      <div className="flex items-center gap-2">
                        <div className="w-20 bg-gray-200 rounded-full h-2">
                          <div className="bg-blue-600 h-2 rounded-full" style={{ width: '15%' }}></div>
                        </div>
                        <span className="font-medium text-sm">15%</span>
                      </div>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">Otros</span>
                      <div className="flex items-center gap-2">
                        <div className="w-20 bg-gray-200 rounded-full h-2">
                          <div className="bg-gray-600 h-2 rounded-full" style={{ width: '22%' }}></div>
                        </div>
                        <span className="font-medium text-sm">22%</span>
                      </div>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </div>

            {/* Análisis de Telemedicina */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <Card>
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <Video className="h-5 w-5 text-purple-600" />
                    Uso de Telemedicina
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <div className="space-y-4">
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">Sesiones Video</span>
                      <span className="font-bold text-purple-600">45%</span>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">Sesiones Audio</span>
                      <span className="font-bold text-blue-600">30%</span>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">Citas Presenciales</span>
                      <span className="font-bold text-green-600">25%</span>
                    </div>
                    <Separator />
                    <div className="text-center pt-2">
                      <p className="text-sm text-gray-600">Satisfacción Telemedicina</p>
                      <p className="text-2xl font-bold text-purple-600">96%</p>
                    </div>
                  </div>
                </CardContent>
              </Card>

              <Card>
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <TrendingUp className="h-5 w-5 text-orange-600" />
                    Tendencias de Citas
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <div className="space-y-4">
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">Citas Completadas</span>
                      <span className="font-bold text-green-600">+15%</span>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">Tiempo de Espera</span>
                      <span className="font-bold text-red-600">-8%</span>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-sm text-gray-600">Retención Pacientes</span>
                      <span className="font-bold text-blue-600">+12%</span>
                    </div>
                    <Separator />
                    <div className="text-center pt-2">
                      <p className="text-sm text-gray-600">Eficiencia General</p>
                      <p className="text-2xl font-bold text-orange-600">+18%</p>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </div>

            {/* Análisis de Riesgo */}
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <AlertTriangle className="h-5 w-5 text-red-600" />
                  Análisis de Riesgo por Paciente
                </CardTitle>
              </CardHeader>
              <CardContent>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                  <div className="text-center p-4 bg-red-50 rounded-lg border border-red-200">
                    <div className="text-2xl font-bold text-red-600">15%</div>
                    <p className="text-sm text-gray-600">Alto Riesgo</p>
                    <p className="text-xs text-gray-500">Requieren seguimiento intensivo</p>
                  </div>
                  <div className="text-center p-4 bg-yellow-50 rounded-lg border border-yellow-200">
                    <div className="text-2xl font-bold text-yellow-600">45%</div>
                    <p className="text-sm text-gray-600">Riesgo Medio</p>
                    <p className="text-xs text-gray-500">Seguimiento regular</p>
                  </div>
                  <div className="text-center p-4 bg-green-50 rounded-lg border border-green-200">
                    <div className="text-2xl font-bold text-green-600">40%</div>
                    <p className="text-sm text-gray-600">Bajo Riesgo</p>
                    <p className="text-xs text-gray-500">Seguimiento estándar</p>
                  </div>
                </div>
              </CardContent>
            </Card>
          </div>
        )}

        {selectedView === 'marketplace' && (
          <div className="space-y-6">
            {/* Estadísticas de Marketplace Médico */}
            <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
              <Card className="border-sky-200 hover:shadow-lg transition-shadow">
                <CardContent className="p-4">
                  <div className="flex items-center">
                    <Stethoscope className="w-8 h-8 text-sky-600 mr-3" />
                    <div>
                      <p className="text-sm text-gray-600">Ofertas Médicas</p>
                      <p className="text-2xl font-bold text-sky-700">{processedOffers.length}</p>
                    </div>
                  </div>
                </CardContent>
              </Card>
              <Card className="border-blue-200 hover:shadow-lg transition-shadow">
                <CardContent className="p-4">
                  <div className="flex items-center">
                    <Users className="w-8 h-8 text-blue-600 mr-3" />
                    <div>
                      <p className="text-sm text-gray-600">Clínicas</p>
                      <p className="text-2xl font-bold text-blue-700">18</p>
                    </div>
                  </div>
                </CardContent>
              </Card>
              <Card className="border-green-200 hover:shadow-lg transition-shadow">
                <CardContent className="p-4">
                  <div className="flex items-center">
                    <UserPlus className="w-8 h-8 text-green-600 mr-3" />
                    <div>
                      <p className="text-sm text-gray-600">Candidatos</p>
                      <p className="text-2xl font-bold text-green-700">234</p>
                    </div>
                  </div>
                </CardContent>
              </Card>
              <Card className="border-purple-200 hover:shadow-lg transition-shadow">
                <CardContent className="p-4">
                  <div className="flex items-center">
                    <CheckCircle className="w-8 h-8 text-purple-600 mr-3" />
                    <div>
                      <p className="text-sm text-gray-600">Contrataciones</p>
                      <p className="text-2xl font-bold text-purple-700">67</p>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-4 gap-8">
              {/* Panel de filtros */}
              <div id="filters-panel" className={`lg:col-span-1 ${showFilters ? 'block' : 'hidden lg:block'}`}>
                <Card className="sticky top-20">
                  <CardHeader>
                    <div className="flex items-center justify-between">
                      <CardTitle className="flex items-center gap-2">
                        <Filter className="h-5 w-5" />
                        Filtros
                      </CardTitle>
                      <Button
                        variant="ghost"
                        onClick={() => setFilters({
                          search: '',
                          location: [],
                          specialty: [],
                          type: [],
                          salaryRange: [0, 20000],
                          experience: [],
                          remote: null,
                          urgent: false
                        })}
                        className="text-sm text-gray-500 hover:text-gray-700 flex items-center p-0"
                      >
                        <X className="w-4 h-4 mr-1" aria-hidden="true" />
                        Limpiar
                      </Button>
                    </div>
                  </CardHeader>
                  <CardContent className="space-y-6">
                    {/* Búsqueda */}
                    <div>
                      <label htmlFor="search-input" className="block text-sm font-medium text-gray-700 mb-2">Búsqueda</label>
                      <div className="relative">
                        <Search className="absolute w-4 h-4 text-gray-400 transform -translate-y-1/2 left-3 top-1/2" aria-hidden="true" />
                        <input
                          id="search-input"
                          type="text"
                          placeholder="Buscar ofertas..."
                          className="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-gray-500 focus:border-transparent"
                          value={filters.search}
                          onChange={(e) => setFilters({...filters, search: e.target.value})}
                        />
                      </div>
                    </div>
                    
                    {/* Ubicación */}
                    <div>
                      <label htmlFor="location-select" className="block text-sm font-medium text-gray-700 mb-2">Ubicación</label>
                      <select
                        id="location-select"
                        multiple
                        className="w-full border border-gray-300 rounded-md p-2 text-sm"
                        value={filters.location}
                        onChange={(e) => {
                          const selected = Array.from(e.target.selectedOptions, option => option.value);
                          setFilters({...filters, location: selected});
                        }}
                      >
                        {LOCATIONS.map((loc) => (
                          <option key={loc} value={loc}>{loc}</option>
                        ))}
                      </select>
                    </div>
                    
                    {/* Especialidad */}
                    <div>
                      <label htmlFor="specialty-select" className="block text-sm font-medium text-gray-700 mb-2">Especialidad</label>
                      <select
                        id="specialty-select"
                        multiple
                        className="w-full border border-gray-300 rounded-md p-2 text-sm"
                        value={filters.specialty}
                        onChange={(e) => {
                          const selected = Array.from(e.target.selectedOptions, option => option.value);
                          setFilters({...filters, specialty: selected});
                        }}
                      >
                        {SPECIALTIES.map((specialty) => (
                          <option key={specialty} value={specialty}>{specialty}</option>
                        ))}
                      </select>
                    </div>
                    
                    {/* Tipo de contrato */}
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-2">Tipo de Contrato</label>
                      <div className="space-y-2">
                        {CONTRACT_TYPES.map(({ value, label }) => (
                          <label key={value} className="flex items-center">
                            <input
                              type="checkbox"
                              checked={filters.type.includes(value)}
                              onChange={(e) => {
                                const newTypes = e.target.checked 
                                  ? [...filters.type, value]
                                  : filters.type.filter(t => t !== value);
                                setFilters({...filters, type: newTypes});
                              }}
                              className="mr-2"
                            />
                            <span className="text-sm text-gray-700">{label}</span>
                          </label>
                        ))}
                      </div>
                    </div>
                    
                    {/* Salario */}
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-2">Rango Salarial (USD mensuales)</label>
                      <div className="flex items-center gap-4">
                        <input
                          type="number"
                          min="0"
                          max="20000"
                          step="1000"
                          placeholder="Mínimo"
                          className="w-full p-2 border border-gray-300 rounded-md"
                          value={filters.salaryRange[0]}
                          onChange={(e) => {
                            const min = Number(e.target.value);
                            setFilters({...filters, salaryRange: [min, filters.salaryRange[1]]});
                          }}
                        />
                        <span className="text-gray-500">-</span>
                        <input
                          type="number"
                          min="0"
                          max="20000"
                          step="1000"
                          placeholder="Máximo"
                          className="w-full p-2 border border-gray-300 rounded-md"
                          value={filters.salaryRange[1]}
                          onChange={(e) => {
                            const max = Number(e.target.value);
                            setFilters({...filters, salaryRange: [filters.salaryRange[0], max]});
                          }}
                        />
                      </div>
                    </div>
                    
                    {/* Experiencia */}
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-2">Experiencia</label>
                      <div className="space-y-2">
                        {EXPERIENCES.map((exp) => (
                          <label key={exp} className="flex items-center">
                            <input
                              type="checkbox"
                              checked={filters.experience.includes(exp)}
                              onChange={(e) => {
                                const newExp = e.target.checked 
                                  ? [...filters.experience, exp]
                                  : filters.experience.filter(e => e !== exp);
                                setFilters({...filters, experience: newExp});
                              }}
                              className="mr-2"
                            />
                            <span className="text-sm text-gray-700">{exp}</span>
                          </label>
                        ))}
                      </div>
                    </div>
                    
                    {/* Opciones adicionales */}
                    <div className="space-y-2">
                      <label className="flex items-center">
                        <input
                          type="checkbox"
                          checked={filters.remote === true}
                          onChange={(e) => setFilters({...filters, remote: e.target.checked ? true : null})}
                          className="mr-2"
                        />
                        <span className="text-sm text-gray-700">Remoto disponible</span>
                      </label>
                      <label className="flex items-center">
                        <input
                          type="checkbox"
                          checked={filters.urgent}
                          onChange={(e) => setFilters({...filters, urgent: e.target.checked})}
                          className="mr-2"
                        />
                        <span className="text-sm text-gray-700">Solo ofertas urgentes</span>
                      </label>
                    </div>
                  </CardContent>
                </Card>
              </div>

              {/* Contenido de Marketplace */}
              <div className="lg:col-span-3 space-y-6">
                {/* Mapa en Marketplace */}
                <Card>
                  <CardHeader>
                    <CardTitle className="flex items-center gap-2">
                      <MapPin className="h-5 w-5 text-sky-600" />
                      Ubicaciones de Clínicas
                    </CardTitle>
                  </CardHeader>
                  <CardContent>
                    <div className="h-96 rounded-md overflow-hidden">
                      <AltamedicaInteractiveMap />
                    </div>
                  </CardContent>
                </Card>

                {/* Resultados */}
                <div className="flex items-center justify-between flex-wrap gap-4">
                  <p className="text-gray-600">
                    {processedOffers.length} ofertas encontradas
                  </p>
                  <div className="flex items-center gap-2 text-sm text-gray-500">
                    <span>Ordenar por:</span>
                    <select 
                      className="border border-gray-300 rounded-md px-2 py-1"
                      value={sortOption}
                      onChange={(e) => setSortOption(e.target.value as SortOption)}
                    >
                      <option value="recent">Más recientes</option>
                      <option value="salary">Mejor pagadas</option>
                      <option value="applications">Más aplicaciones</option>
                      <option value="rating">Mejor rating</option>
                    </select>
                  </div>
                  <div className="flex items-center gap-4">
                    <Button
                      variant="outline"
                      onClick={() => setShowFilters(!showFilters)}
                      className="lg:hidden"
                    >
                      <Sliders className="w-4 h-4 mr-2" />
                      Filtros
                    </Button>
                    <div className="flex items-center bg-white border border-gray-200 rounded-md">
                      <Button
                        variant="ghost"
                        onClick={() => setViewMode('grid')}
                        className={`p-2 ${viewMode === 'grid' ? 'text-gray-900 bg-gray-100' : 'text-gray-500'}`}
                      >
                        <Grid className="w-4 h-4" />
                      </Button>
                      <Button
                        variant="ghost"
                        onClick={() => setViewMode('list')}
                        className={`p-2 ${viewMode === 'list' ? 'text-gray-900 bg-gray-100' : 'text-gray-500'}`}
                      >
                        <List className="w-4 h-4" />
                      </Button>
                    </div>
                  </div>
                </div>

                {/* Ofertas */}
                <div className={`grid gap-6 ${
                  viewMode === 'grid' 
                    ? 'grid-cols-1 md:grid-cols-2' 
                    : 'grid-cols-1'
                }`}>
                  {processedOffers.map((offer) => (
                    <OfferCard
                      key={offer.id}
                      offer={offer}
                      viewMode={viewMode}
                      onViewDetails={handleViewDetails}
                      onApply={handleApply}
                      onSave={handleSave}
                      onShare={handleShare}
                    />
                  ))}
                </div>

                {processedOffers.length === 0 && (
                  <div className="text-center py-12">
                    <AlertCircle className="w-12 h-12 text-gray-400 mx-auto mb-4" aria-hidden="true" />
                    <h3 className="text-lg font-medium text-gray-900 mb-2">No se encontraron ofertas</h3>
                    <p className="text-gray-600">Intenta ajustar los filtros de búsqueda</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}