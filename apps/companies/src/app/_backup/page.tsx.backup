            {[
              { id: 'overview', label: 'Resumen', icon: BarChart3 },
              { id: 'patients', label: 'Pacientes', icon: Users },
              { id: 'doctors', label: 'Médicos', icon: UserCheck },
              { id: 'appointments', label: 'Citas', icon: Calendar },
