              <Card className="border-teal-200 hover:shadow-lg transition-shadow">
                <CardContent className="p-6">
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm font-medium text-gray-600">Satisfacción Pacientes</p>
                      <p className="text-2xl font-bold text-teal-700">{metrics?.patientSatisfaction}%</p>
                      <p className="text-xs text-gray-500">Encuestas recientes</p>
