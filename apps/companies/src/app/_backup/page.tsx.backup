const OfferCard = ({ offer, viewMode, onViewDetails, onApply, onSave, onShare }: {
  offer: MarketplaceOffer;
  viewMode: 'grid' | 'list';
  onViewDetails: (id: string) => void;
  onApply: (id: string) => void;
  onSave: (id: string) => void;
  onShare: (id: string) => void;
}) => {
  const isGrid = viewMode === 'grid';
  
  return (
    <div 
      role="article"
      aria-labelledby={`offer-title-${offer.id}`}
      className={`bg-white rounded-lg border border-gray-200 hover:shadow-lg transition-all duration-300 ${
        isGrid ? 'p-6' : 'p-4'
      }`}
    >
      <div className={`${isGrid ? 'space-y-4' : 'flex items-start gap-4'}`}>
        <div className={`${isGrid ? 'space-y-2' : 'flex-1'}`}>
          <div className="flex items-start justify-between">
            <div className="flex-1">
              <div className="flex items-center gap-2 mb-1">
                <h3 id={`offer-title-${offer.id}`} className={`font-semibold text-gray-900 ${isGrid ? 'text-lg' : 'text-base'}`}>
                  {offer.title}
                </h3>
                {offer.urgent && (
                  <Badge variant="destructive">Urgente</Badge>
                )}
              </div>
              <p className="text-sm text-gray-600">{offer.company}</p>
            </div>
            <div className="flex items-center">
              <Star className="h-4 w-4 text-yellow-500 mr-1" aria-hidden="true" />
              <span className="text-sm font-medium">{offer.rating}</span>
            </div>
          </div>
          
          <div className={`space-y-1 text-sm text-gray-600 ${isGrid ? '' : 'flex items-center gap-4 flex-wrap'}`}>
            <div className="flex items-center">
              <MapPin className="w-4 h-4 mr-2 text-gray-400" aria-hidden="true" />
              <span>{offer.location}</span>
            </div>
            <div className="flex items-center">
              <Briefcase className="w-4 h-4 mr-2 text-gray-400" aria-hidden="true" />
              <span>{offer.specialty}</span>
            </div>
            <div className="flex items-center">
              <DollarSign className="w-4 h-4 mr-2 text-green-600" aria-hidden="true" />
              <span className="font-medium">{offer.salary}</span>
            </div>
          </div>
        </div>
        
        <div className={`flex gap-2 ${isGrid ? 'mt-4 flex-wrap' : 'flex-col'}`}>
          <Button
            variant="outline"
            onClick={() => onViewDetails(offer.id)}
            className="flex items-center justify-center"
            aria-label={`Ver detalles de ${offer.title}`}
          >
            <Eye className="w-4 h-4 mr-1" />
            Detalles
          </Button>
          <Button
            variant="default"
            onClick={() => onApply(offer.id)}
            className="flex items-center justify-center"
            aria-label={`Aplicar a ${offer.title}`}
          >
            <Send className="w-4 h-4 mr-1" />
            Aplicar
          </Button>
          <Button
            variant="outline"
            onClick={() => onSave(offer.id)}
            className="flex items-center justify-center"
            aria-label={`Guardar ${offer.title}`}
          >
            <Bookmark className="w-4 h-4 mr-1" />
            Guardar
          </Button>
          <Button
            variant="outline"
            onClick={() => onShare(offer.id)}
            className="flex items-center justify-center"
            aria-label={`Compartir ${offer.title}`}
          >
            <Share2 className="w-4 h-4 mr-1" />
            Compartir
          </Button>
        </div>
      </div>
      
      <div className="mt-4 pt-4 border-t border-gray-100">
        <div className="flex items-center justify-between text-xs text-gray-500">
          <span>Publicado: {new Date(offer.postedDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          <span>{offer.applications} aplicaciones</span>
        </div>
        <div className="flex items-center gap-4 text-xs text-gray-500 mt-2 flex-wrap">
          <span>Experiencia: {offer.experience}</span>
          <span>Horario: {offer.schedule}</span>
          {offer.remote && <span className="text-green-600">Remoto disponible</span>}
        </div>
      </div>
    </div>
  );
};

export default function ClinicDashboard() {
  const [metrics, setMetrics] = useState<ClinicMetrics | null>(null);
  const [patients, setPatients] = useState<Patient[]>([]);
  const [doctors, setDoctors] = useState<Doctor[]>([]);
  const [appointments, setAppointments] = useState<Appointment[]>([]);
  const [analytics, setAnalytics] = useState<PatientAnalytics | null>(null);
  const [equipment, setEquipment] = useState<MedicalEquipment[]>([]);
  const [loading, setLoading] = useState(true);
  const [selectedView, setSelectedView] = useState<'overview' | 'patients' | 'doctors' | 'appointments' | 'telemedicine' | 'equipment' | 'analytics' | 'marketplace'>('overview');

  // Estados para marketplace
  const [filters, setFilters] = useState<FilterState>({
    search: '',
    location: [],
    specialty: [],
    type: [],
    salaryRange: [0, 20000],
    experience: [],
    remote: null,
    urgent: false
  });
  
  const [viewMode, setViewMode] = useState<'grid' | 'list'>('grid');
  const [showFilters, setShowFilters] = useState(false);
  const [sortOption, setSortOption] = useState<SortOption>('recent');

  // Función para parsear salario
  const parseSalary = useCallback((salary: string): number => {
    const numbers = salary.match(/\d+/g)?.map(Number) || [0];
    return numbers.length === 2 ? (numbers[0] + numbers[1]) / 2 * 1000 : numbers[0] * 1000;
  }, []);

  // Procesar ofertas
  const processedOffers = useMemo(() => {
    let offers = ALL_OFFERS.filter(offer => {
      const searchLower = filters.search.toLowerCase();
      if (searchLower && 
          !offer.title.toLowerCase().includes(searchLower) &&
          !offer.company.toLowerCase().includes(searchLower) &&
          !offer.specialty.toLowerCase().includes(searchLower)) {
        return false;
      }
      
      if (filters.location.length > 0 && !filters.location.includes(offer.location)) return false;
      if (filters.specialty.length > 0 && !filters.specialty.includes(offer.specialty)) return false;
      if (filters.type.length > 0 && !filters.type.includes(offer.type)) return false;
      
      const avgSalary = parseSalary(offer.salary);
      if (avgSalary < filters.salaryRange[0] * 1000 || avgSalary > filters.salaryRange[1] * 1000) return false;
      
      if (filters.experience.length > 0 && !filters.experience.includes(offer.experience)) return false;
      if (filters.remote !== null && offer.remote !== filters.remote) return false;
      if (filters.urgent && !offer.urgent) return false;
      
      return true;
    });

    offers = [...offers].sort((a, b) => {
      switch (sortOption) {
        case 'recent':
          return new Date(b.postedDate).getTime() - new Date(a.postedDate).getTime();
        case 'salary':
          return parseSalary(b.salary) - parseSalary(a.salary);
        case 'applications':
          return b.applications - a.applications;
        case 'rating':
          return b.rating - a.rating;
        default:
          return 0;
      }
    });

    return offers;
  }, [filters, sortOption, parseSalary]);

  const handleViewDetails = (id: string) => {
    console.log('Ver detalles de oferta:', id);
  };

  const handleApply = (id: string) => {
    console.log('Aplicar a oferta:', id);
  };

  const handleSave = (id: string) => {
    console.log('Guardar oferta:', id);
