{
  "name": "@altamedica/web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node run-dev-optimized.js",
    "dev:direct": "next dev",
    "dev:turbo": "next dev --turbo",
    "dev:fast": "NODE_OPTIONS='--max-old-space-size=8192' next dev --turbo",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "playwright:install": "playwright install",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "analyze": "node analyze-bundle.js",
    "analyze:performance": "node scripts/analyze-performance.js",
    "monitor": "node performance-monitor.js",
    "dev:monitor": "concurrently \"npm run dev\" \"npm run monitor\"",
    "lighthouse": "npx lighthouse http://localhost:3000 --output=json --output-path=./reports/lighthouse-report.json",
    "optimize": "npm run clean && npm run build:analyze",
    "debug:buttons": "node debug-buttons.js",
    "dev:debug": "NEXT_PUBLIC_DEBUG_BUTTONS=true npm run dev",
    "validate:routes": "node validate-routes.js",
    "servers:start": "node scripts/start-sso-testing-servers.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:patient": "node scripts/run-patient-tests.js",
    "test:patient:headed": "node scripts/run-patient-tests.js --headed",
    "test:patient:debug": "node scripts/run-patient-tests.js --debug",
    "test:patient:ui": "node scripts/run-patient-tests.js --ui",
    "test:sso": "playwright test sso-multi-user-flow.spec.ts",
    "test:sso:ui": "playwright test sso-multi-user-flow.spec.ts --ui",
    "test:sso:headed": "playwright test sso-multi-user-flow.spec.ts --headed"
  },
  "dependencies": {
    "@altamedica/auth": "workspace:*",
  "@altamedica/hooks": "workspace:*",
    "@altamedica/firebase-config": "workspace:*",
    "@altamedica/shared": "workspace:*",
    "@altamedica/ui": "workspace:*",
    "@altamedica/utils": "workspace:*",
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.12",
    "@react-three/drei": "^10.3.0",
    "@react-three/fiber": "^9.1.2",
    "@sentry/nextjs": "^8.0.0",
    "@tanstack/react-query": "^5.81.2",
    "@tanstack/react-query-devtools": "^5.81.2",
    "@tweenjs/tween.js": "^25.0.0",
    "@types/leaflet": "^1.9.8",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "date-fns": "^4.1.0",
    "firebase": "^10.0.0",
    "framer-motion": "^12.19.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.536.0",
    "next": "15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.58.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.0.0",
    "sonner": "^2.0.5",
    "styled-jsx": "^5.1.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.177.0",
    "zod": "^3.25.67",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.19.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
