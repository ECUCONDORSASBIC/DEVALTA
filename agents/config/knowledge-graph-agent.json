{
  "port": 3006,
  "host": "localhost",
  "name": "knowledge-graph-agent",
  "logLevel": "info",
  "corsOrigins": ["http://localhost:3000"],
  "enableWebSocket": true,
  "enableMetrics": true,
  "healthCheckInterval": 30000,
  "neo4j": {
    "uri": "bolt://localhost:7687",
    "user": "neo4j",
    "password": "password"
  },
  "firestore": {
    "projectId": "altamedica-dev",
    "snapshotCollection": "knowledge-graph-snapshots"
  },
  "snapshot": {
    "interval": "0 2 * * *",
    "retention": 30
  },
  "eventBus": {
    "url": "ws://localhost:3010/event-bus",
    "reconnectInterval": 5000,
    "maxReconnectAttempts": 10
  }
}
