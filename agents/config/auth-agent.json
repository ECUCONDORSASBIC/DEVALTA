{
  "port": 3001,
  "host": "localhost",
  "name": "auth-agent",
  "logLevel": "info",
  "corsOrigins": ["http://localhost:3000", "https://altamedica.com"],
  "enableWebSocket": true,
  "enableMetrics": true,
  "healthCheckInterval": 30000,
  "jwt": {
    "secret": "your-jwt-secret-key-here",
    "expiresIn": "24h",
    "refreshExpiresIn": "7d",
    "algorithm": "HS256"
  },
  "session": {
    "secret": "your-session-secret-key-here",
    "maxAge": 86400000,
    "secure": false
  },
  "database": {
    "url": "postgresql://user:password@localhost:5432/altamedica",
    "maxConnections": 10
  }
}
