{
  "name": "@altamedica/agents",
  "version": "1.0.0",
  "description": "ALTAMEDICA MCP Agents - Specialized microservice agents",
  "private": true,
  "type": "module",
  "scripts": {
    "start:auth-agent": "tsx src/auth-agent/index.ts",
    "start:routing-agent": "tsx src/routing-agent/index.ts",
    "start:security-agent": "tsx src/security-agent/index.ts",
    "start:monitoring-agent": "tsx src/monitoring-agent/index.ts",
    "start:patient-monitoring-agent": "tsx src/patient-monitoring-agent/start.ts",
    "start:emergency-coordination-agent": "tsx src/emergency-coordination-agent/start.ts",
    "start:scheduling-optimization-agent": "tsx src/scheduling-optimization-agent/start.ts",
    "start:devops-agent": "tsx src/devops-agent/index.ts",
    "start:knowledge-graph-agent": "tsx src/knowledge-graph-agent/index.ts",
    "start:event-bus": "tsx src/event-bus/index.ts",
    "start": "node start-medical-ai-system.js",
    "start:all": "concurrently \"pnpm run start:event-bus\" \"pnpm run start:auth-agent\" \"pnpm run start:routing-agent\" \"pnpm run start:security-agent\" \"pnpm run start:monitoring-agent\" \"pnpm run start:devops-agent\" \"pnpm run start:knowledge-graph-agent\" \"pnpm run start:patient-monitoring-agent\" \"pnpm run start:emergency-coordination-agent\" \"pnpm run start:scheduling-optimization-agent\"",
    "start:core": "concurrently \"pnpm run start:event-bus\" \"pnpm run start:auth-agent\" \"pnpm run start:routing-agent\" \"pnpm run start:security-agent\" \"pnpm run start:monitoring-agent\"",
    "start:medical": "concurrently \"pnpm run start:patient-monitoring-agent\" \"pnpm run start:emergency-coordination-agent\" \"pnpm run start:scheduling-optimization-agent\" \"pnpm run start:knowledge-graph-agent\"",
    "test:collaborative": "ts-node start-collaborative-test.ts",
    "test:scenario": "ts-node test/collaborative-scenario.ts",
    "test:patient-monitoring": "tsx test/patient-monitoring-test.ts",
    "build": "tsc",
    "dev": "concurrently \"pnpm run dev:auth\" \"pnpm run dev:routing\" \"pnpm run dev:security\" \"pnpm run dev:monitoring\" \"pnpm run dev:devops\" \"pnpm run dev:knowledge-graph\"",
    "dev:auth": "nodemon src/auth-agent/index.ts",
    "dev:routing": "nodemon src/routing-agent/index.ts",
    "dev:security": "nodemon src/security-agent/index.ts",
    "dev:monitoring": "nodemon src/monitoring-agent/index.ts",
    "dev:devops": "nodemon src/devops-agent/index.ts",
    "dev:knowledge-graph": "nodemon src/knowledge-graph-agent/index.ts",
    "dev:event-bus": "nodemon src/event-bus/index.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run --dir tests/unit",
    "test:unit:coverage": "vitest run --dir tests/unit --coverage",
    "test:integration": "vitest run --dir tests/integration",
    "test:contract": "vitest run --dir tests/contract",
    "test:chaos": "vitest run --dir tests/chaos",
    "test:performance": "k6 run tests/performance/baseline.js",
    "test:smoke": "vitest run --dir tests/smoke",
    "test:all": "pnpm run test:unit && pnpm run test:integration && pnpm run test:contract",
    "test:ci": "pnpm run test:all -- --reporter=junit --outputFile=test-results.xml",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "validate:schemas": "node scripts/validate-schemas.js",
    "validate:otel-config": "node scripts/validate-otel.js",
    "validate:dashboards": "node scripts/validate-dashboards.js"
  },
  "dependencies": {
    "@altamedica/shared": "workspace:*",
    "@altamedica/types": "workspace:*",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "ws": "^8.14.2",
    "node-cron": "^3.0.3",
    "axios": "^1.6.0",
    "zod": "^3.22.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "rate-limiter-flexible": "^4.0.1",
    "onnxruntime-node": "^1.16.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/ws": "^8.5.10",
    "@types/node-cron": "^3.0.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.3.3",
    "tsx": "^4.7.1",
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "vitest": "^1.0.4",
    "eslint": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0"
  }
}
