# Use the official Node.js 22 image as the base image
FROM node:22-alpine

# Set the working directory inside the container
WORKDIR /app

# Copy package.json and pnpm-lock.yaml to the working directory
# This allows pnpm install to leverage Docker's cache
COPY package.json pnpm-lock.yaml ./

# Install pnpm globally
RUN npm install -g pnpm

# Install dependencies using pnpm
RUN pnpm install --frozen-lockfile

# Copy the rest of the application code
COPY . .

# Build the agents application (if applicable, assuming a build step is needed)
# If your agents application doesn't require a build step, you can remove this line.
# RUN pnpm build

# Expose the port the agents service will run on (adjust if different)
EXPOSE 3005

# Command to run the application
# This assumes your agents service has a "start" script in its package.json
CMD ["pnpm", "start"]