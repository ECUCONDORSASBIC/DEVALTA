# 🤖 ALTAMEDICA Medical AI Agents - Development Container
# Versión simplificada para desarrollo sin compilación TypeScript
FROM node:22-alpine

# Instalar dependencias básicas y herramientas de desarrollo
RUN apk add --no-cache \
    curl \
    ca-certificates \
    dumb-init \
    python3 \
    make \
    g++ \
    && addgroup -g 1001 -S nodejs \
    && adduser -S altamedica -u 1001

# Configurar directorio de trabajo
WORKDIR /app

# Instalar pnpm con versión específica
RUN npm install -g pnpm@10.13.1 tsx

# Copiar configuración del workspace
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
COPY packages/ ./packages/

# Copiar configuración específica de agentes
COPY agents/package.json ./agents/
COPY agents/tsconfig.json ./agents/

# Instalar dependencias (desarrollo)
ENV NODE_ENV=development
ENV TENSORFLOW_ENV=node
ENV NODE_OPTIONS="--max-old-space-size=2048"
RUN pnpm install --frozen-lockfile

# Copiar código fuente de agentes
COPY agents/src/ ./agents/src/
COPY agents/config/ ./agents/config/
COPY agents/start-medical-ai-system.js ./agents/

# Crear directorio para modelos médicos
RUN mkdir -p ./agents/models && \
    echo '{"model": "medical-diagnosis-v1.0", "size": "15MB"}' > ./agents/models/medical-diagnosis.json && \
    echo '{"model": "cardiovascular-risk-v1.0", "size": "8MB"}' > ./agents/models/cardiovascular-risk.json && \
    echo '{"model": "medical-nlp-es-v1.0", "size": "12MB"}' > ./agents/models/medical-nlp.json

# Crear directorio para logs
RUN mkdir -p /app/logs /app/temp && \
    chown -R altamedica:nodejs /app/logs /app/temp

# Cambiar a usuario no-root (HIPAA compliance)
USER altamedica

# Configurar variables de entorno para AI médica
ENV ALTAMEDICA_AI_MODE=medical
ENV ALTAMEDICA_COMPLIANCE=hipaa
ENV PORT=3006

# Health check especializado para desarrollo
HEALTHCHECK --interval=30s --timeout=15s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Exponer puerto principal y puertos de agentes individuales
EXPOSE 3006 3007 3008 3009 3010 3011 3012 3013 3014

# Comando de inicio para desarrollo con tsx (TypeScript execution)
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "agents/start-medical-ai-system.js"]

# Metadata del contenedor
LABEL maintainer="AltaMedica Team <dev@altamedica.com>"
LABEL description="AI Medical Agents Development Container"
LABEL version="1.0.0-dev"
LABEL compliance="HIPAA"
LABEL mode="development"