{
  "name": "@altamedica/root",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de telemedicina profesional con WebRTC, IA médica y compliance HIPAA - Workspace Root",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently \"pnpm --filter @altamedica/api-server dev\" \"pnpm --filter @altamedica/doctors dev\" \"pnpm --filter @altamedica/patients dev\" \"pnpm --filter @altamedica/signaling-server dev\"",
    "dev:core": "concurrently \"pnpm --filter @altamedica/api-server dev\" \"pnpm --filter @altamedica/signaling-server dev\"",
    "dev:doctors": "pnpm --filter @altamedica/doctors dev",
    "dev:patients": "pnpm --filter @altamedica/patients dev",
    "dev:api-server": "pnpm --filter @altamedica/api-server dev",
    "dev:signaling": "pnpm --filter @altamedica/signaling-server dev",
    "dev:web-app": "pnpm --filter @altamedica/web-app dev",
    "dev:companies": "pnpm --filter @altamedica/companies dev",
    "dev:admin": "pnpm --filter @altamedica/admin dev",
    "build": "next build",
    "build:all": "pnpm --filter @altamedica/web-app build && pnpm --filter @altamedica/api-server build && pnpm --filter @altamedica/doctors build && pnpm --filter @altamedica/patients build && pnpm --filter @altamedica/companies build && pnpm --filter @altamedica/admin build",
    "start": "next start",
    "test": "jest",
    "test:all": "pnpm --filter @altamedica/api-server test && pnpm --filter @altamedica/doctors test && pnpm --filter @altamedica/patients test",
    "test:accessibility": "pnpm --filter @altamedica/patients test -- --testPathPattern=accessibility",
    "test:webrtc": "pnpm --filter @altamedica/signaling-server test -- --testPathPattern=webrtc",
    "test:ai": "pnpm --filter @altamedica/api-server test -- --testPathPattern=ai",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:headless": "cypress run --headless",
    "test:e2e:chrome": "cypress run --browser chrome",
    "test:e2e:record": "cypress run --record",
    "test:bidirectional": "node test-bidirectional-communication.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next dist",
    "check-api": "node scripts/setup/check-api-connection.js",
    "ci:test": "pnpm lint && pnpm type-check && pnpm test:all",
    "ci:deploy": "pnpm build && pnpm ci:test"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/react": "^4.9.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^13.0.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.2.2",
    "cypress": "^13.17.0",
    "cypress-multi-reporters": "^2.0.5",
    "cypress-real-events": "^1.14.0",
    "eslint": "^9.30.0",
    "jest": "^29.0.0",
    "node-mocks-http": "^1.17.2",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.0",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "telemedicina",
    "webrtc",
    "ai",
    "hipaa",
    "accesibilidad",
    "react",
    "nextjs"
  ],
  "packageManager": "pnpm@10.13.1",
  "author": "Eduardo Altamedica",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardo-altamedica/telemedicine-demo.git"
  },
  "bugs": {
    "url": "https://github.com/eduardo-altamedica/telemedicine-demo/issues"
  },
  "homepage": "https://github.com/eduardo-altamedica/telemedicine-demo#readme"
}
